#!/usr/bin/env bash
# dumpling 的 pre-push hook（安裝方式見 docs/HANDOFF.md）。
# 每次推送前，用 origin/main 上的 ci/public-check.sh 檢查要推的 commit，
# 並加上只放本機的禁用字清單 ~/.config/dumpling/forbidden.txt。
set -uo pipefail
priv="$HOME/.config/dumpling/forbidden.txt"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
src=origin/main
git rev-parse -q --verify "$src" >/dev/null || src=HEAD
git show "$src:ci/public-check.sh" > "$tmp/check.sh" 2>/dev/null || { echo "pre-push: 找不到 ci/public-check.sh，略過" >&2; exit 0; }
git show "$src:ci/public-patterns.txt" > "$tmp/patterns.txt" 2>/dev/null || : > "$tmp/patterns.txt"
zero=0000000000000000000000000000000000000000
fail=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" != "$zero" ] && git cat-file -e "$rsha" 2>/dev/null; then
    range="$rsha..$lsha"
  elif git rev-parse -q --verify origin/main >/dev/null && git merge-base --is-ancestor origin/main "$lsha" 2>/dev/null; then
    range="origin/main..$lsha"
  else
    range="$lsha"
  fi
  bash "$tmp/check.sh" --rev "$lsha" --range "$range" --patterns "$tmp/patterns.txt" --private "$priv" || fail=1
done
if [ "$fail" -ne 0 ]; then
  echo "pre-push：發現不能公開的內容，已阻止推送。" >&2
  exit 1
fi
