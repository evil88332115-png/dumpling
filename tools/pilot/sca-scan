    if sandbox_secret_probe "$OUT/sbom/sandbox-secrets.txt" "$PILOT_ENV" "$PENV_DIR" "$DT_HDR" "$DJ_HDR"; then
      status B-sandbox-secrets OK "沙箱內讀不到：$(grep -c '^讀不到' "$OUT/sbom/sandbox-secrets.txt") 個受測路徑（家目錄與 RUNNER_TEMP 的假檔、憑證位置、npm 全域設定、runner 目錄、PILOT_ENV 與其資料夾、金鑰標頭；見 sbom/sandbox-secrets.txt）$PENV_NOTE"
    else status B-sandbox-secrets FAIL "沙箱內讀得到：$(grep '讀得到（不應該）' "$OUT/sbom/sandbox-secrets.txt" | sed 's/^讀得到（不應該）：//' | tr '\n' ' ')"; SBX_OK=0; fi
  fi
fi
if [ $SRC_OK != 1 ]; then status B-sbom NOT_RUN "沒有來源"
elif [ $SBX_OK != 1 ]; then status B-sbom NOT_RUN "沙箱不可用（見 B-sandbox）：不在沒有隔離的環境執行不可信程式"
elif [ "$MODE" = sbom ]; then
  cp "$S/sbom.json" "$SBOM"; sbom_status B-sbom-provided 0 "$SBOM"; [ "$(jlen "$SBOM" components)" != x ] && SBOM_OK=1
elif [ "$MODE" = image ]; then
  o=$WORK/o/syft; mkdir -p "$o" "$WORK/o/syft-tmp"
  # Syft 1.55.0 scan 說明：docker-archive:path/to/yourimage.tar（cmd/syft/internal/commands/scan.go）；映像先由 docker save 存成檔，沙箱內無網路。
  # 解開映像層用 TMPDIR（指到暫存區，不用沙箱的 /tmp tmpfs，避免大映像佔用記憶體）
  runlog syft "$OUT/sbom/syft.stdout.txt" "$OUT/sbom/syft.stderr.txt" sbx "$o" "$WORK/o/syft-tmp" -- SYFT_CHECK_FOR_APP_UPDATE=false "TMPDIR=$WORK/o/syft-tmp" \
    syft "docker-archive:$IMG_TAR" -o "cyclonedx-json=$o/bom.cdx.json" -o "syft-json=$o/syft.json"; x=$?
  cp "$o/bom.cdx.json" "$SBOM" 2>/dev/null; sbom_status B-sbom-syft $x "$SBOM"; [ "$(jlen "$SBOM" components)" != x ] && [ $x = 0 ] && SBOM_OK=1
  # PHP 執行檔辨識（同 images.sh）：映像的 PHP_VERSION 環境變數 vs Syft 辨識的 php-cli／php-fpm／php-cgi 版本
  if [ $SBOM_OK = 1 ]; then
    sv=$(python3 -I -c 'import json,sys
a=json.load(open(sys.argv[1])).get("artifacts",[])
print(",".join(sorted({x.get("version","") for x in a if x.get("name") in ("php-cli","php-fpm","php","php-cgi") and x.get("version")})))' "$o/syft.json" 2>/dev/null)
    META[php_env]=${envphp:-}; META[php_syft]=${sv:-}
    if [ -n "$envphp" ] || [ -n "$sv" ]; then
      if [ -z "$envphp" ]; then status B-php-runtime ATTENTION "Syft 辨識 PHP 執行檔 $sv；映像沒有 PHP_VERSION 環境變數，無法交叉核對"
      elif [ -z "$sv" ]; then status B-php-runtime GAP "映像 PHP_VERSION $envphp，但 Syft 沒有辨識出 PHP 執行檔版本：PHP 核心弱點（例如 PHP2Shell）無法比對"
      elif [ "$envphp" = "$sv" ]; then status B-php-runtime OK "Syft 辨識 $sv＝映像 PHP_VERSION $envphp"
      else status B-php-runtime ATTENTION "Syft 辨識 $sv，映像 PHP_VERSION $envphp：不一致"; fi
    fi
  fi
else
  # Maven／Gradle 專案要 java（與 mvn）才能解析依賴；沒有時 cdxgen 只會退回讀 pom.xml（2026-10-23 實機：petclinic 163 → 19 個元件）
  if [ -n "$(find "$S" -maxdepth 3 \( -name pom.xml -o -name build.gradle -o -name build.gradle.kts \) -not -path '*/node_modules/*' 2>/dev/null | head -1)" ]; then
    # pom.xml 可能在子資料夾（例如 spring-guides 的 complete/、initial/），只看根目錄會漏報缺 mvn
    miss=; have java || miss="$miss java"
    [ -n "$(find "$S" -maxdepth 3 -name pom.xml -not -path '*/node_modules/*' 2>/dev/null | head -1)" ] && ! have mvn && miss="$miss mvn"
    [ -n "$miss" ] && status B-toolchain GAP "Maven／Gradle 專案但缺$miss：cdxgen 只能讀 pom.xml／build.gradle，依賴不完整"
  fi
  o=$WORK/o/cdxgen; C=$WORK/cdxgen-src; mkdir -p "$o"; rm -rf "$C"; cp -a "$S" "$C"   # cdxgen 可能改寫專案（套件管理器），給它獨立副本
  net=(); goenv=(GOPROXY=off); [ $NETRES = 1 ] && { net=(--net); goenv=(); }
  runlog cdxgen "$OUT/sbom/cdxgen.stdout.txt" "$OUT/sbom/cdxgen.stderr.txt" sbx "${net[@]}" "$C" "$o" -- "${goenv[@]}" GOFLAGS= GOTOOLCHAIN=local GOCACHE=/tmp/gocache GOPATH=/tmp/gopath \
    "JAVA_HOME=${JAVA_HOME:-}" JAVA_TOOL_OPTIONS=-Duser.home=/tmp/home GRADLE_USER_HOME=/tmp/gradle \
    cdxgen -r "$C" -o "$o/bom.json" --no-banner; x=$?
  cp "$o/bom.json" "$SBOM" 2>/dev/null; sbom_status B-sbom-cdxgen $x "$SBOM"; [ "$(jlen "$SBOM" components)" != x ] && [ $x = 0 ] && SBOM_OK=1
  [ $NETRES = 1 ] && status B-network-resolve ATTENTION "cdxgen 在有網路的沙箱內執行（連網解析）：結果依解析當下的套件註冊中心而定"
  # 規則 14：沒有鎖定檔的 npm 專案，cdxgen 會執行 npm install（已在沙箱內）；沒有網路時依賴解析不出來
  if [ -f "$S/package.json" ] && ! [ -f "$S/package-lock.json" ] && ! [ -f "$S/npm-shrinkwrap.json" ] && ! [ -f "$S/yarn.lock" ] && ! [ -f "$S/pnpm-lock.yaml" ]; then
    if [ $NETRES = 1 ]; then status B-npm-no-lockfile ATTENTION "沒有鎖定檔：cdxgen 在沙箱內連網執行 npm install（規則 14），版本是解析當下的結果"
    else status B-npm-no-lockfile GAP "沒有鎖定檔：cdxgen 在無網路沙箱內執行 npm install（規則 14），依賴無法解析；要完整結果需提供鎖定檔或 --allow-network-resolve"; fi
  fi
  rm -rf "$C"
fi
[ -s "$SBOM" ] || rm -f "$SBOM"
# 之後的 Grype（沙箱內）與上傳都用暫存區的副本：輸出資料夾可能在 /tmp 底下（沙箱內看不到），路徑也可能含 curl -F 會解讀的 ; 或 ,
BOMW=$WORK/bom.cdx.json; [ -s "$SBOM" ] && cp "$SBOM" "$BOMW"
# --py-versions（tools/cra/py_dpkg_version.py scan 的 python-versions.json）：Debian 打包的 Python 模組的 egg-info 版本是佔位值（0.0.0）時，
# $BOMW 換成把「dpkg 擁有者的上游版本」寫進去的副本（只改 RESOLVED 的元件；版本、purl、cpe，並加 sca:version-source／sca:original-version 屬性），
# Grype、sbomgate、上傳 DT 都用它；原始 SBOM（$SBOM＝sbom/sbom.cdx.json）不動，另存一份 sbom/sbom.pyver.cdx.json 當作實際比對的那一份。
# 失敗 → 照原本的 SBOM 比對，記 GAP（C-pyver），不靜默。
rm -f "$OUT/sbom/sbom.pyver.cdx.json"
if [ -n "$PYVERS" ] && [ $SBOM_OK = 1 ] && [ -s "$BOMW" ]; then
  r=$(python3 -I "$ROOT/tools/cra/py_dpkg_version.py" apply --sbom "$BOMW" --resolved "$PYVERS" --out "$WORK/bom.pyver.cdx.json" 2>&1); x=$?
  l=$(printf '%s\n' "$r" | grep -m1 $'^PYVER-APPLY\t')
  if [ $x = 0 ] && [ -n "$l" ] && [ -s "$WORK/bom.pyver.cdx.json" ]; then IFS=$'\t' read -r _ s2 s3 <<< "$l"
    if mv "$WORK/bom.pyver.cdx.json" "$BOMW" && cp "$BOMW" "$OUT/sbom/sbom.pyver.cdx.json"; then status C-pyver "$s2" "$s3（Grype 與 DT 用 sbom/sbom.pyver.cdx.json；原始 SBOM 為 sbom/sbom.cdx.json）"
    else status C-pyver GAP "無法換用改過版本的 SBOM；照原本的 SBOM 比對（佔位值版本的 Python 模組未解析）"; fi
  else status C-pyver GAP "py_dpkg_version.py apply 失敗：$(echo "$r" | tail -1)；照原本的 SBOM 比對（佔位值版本的 Python 模組未解析）"; fi
elif [ -n "$PYVERS" ]; then status C-pyver NOT_RUN "沒有 SBOM"; fi
# Jetson Linux（L4T）的核心（tools/pilot/lib/l4t_kernel.py）：映像與 --sbom。nvidia-l4t-kernel 的 L4T 版本在 l4t-kernel-map.json 有對應時，
# $BOMW 換成加上對應的 Canonical 核心原始碼套件（例如 linux-nvidia-tegra，只供比對）的副本，Grype、sbomgate、上傳 DT 都用它；
# 原始 SBOM（$SBOM）不動，ScanCode.io／DejaCode 不收這個元件（scio_prep.py）。沒有 L4T 核心（NOT_RUN）時不寫這一列；
# 版本沒有對應 → GAP（核心仍沒有比對，C-kernel-coverage 也會是 GAP）。
rm -f "$OUT/scan/l4t-kernel-map.json"   # 同一個 --out 重跑：不留上一次的摘要給 kernelcheck、cra_report（l4t_kernel.py 失敗或沒有執行時）
if [[ "$MODE" =~ ^(image|sbom)$ ]] && [ $SBOM_OK = 1 ] && [ -s "$BOMW" ]; then
  r=$(python3 -I "$ROOT/tools/pilot/lib/l4t_kernel.py" --sbom "$BOMW" --map "$ROOT/tools/pilot/lib/l4t-kernel-map.json" \
    --out-sbom "$WORK/bom.kmap.cdx.json" --summary "$OUT/scan/l4t-kernel-map.json" 2>&1)
  l=$(printf '%s\n' "$r" | grep -m1 $'^C-kernel-l4t-map\t')
  if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"
    case $s2 in
      NOT_RUN) rm -f "$OUT/scan/l4t-kernel-map.json";;
      OK) if mv "$WORK/bom.kmap.cdx.json" "$BOMW"; then status "$s1" OK "$s3（scan/l4t-kernel-map.json）"
          else status C-kernel-l4t-map FAIL "無法換用加上核心元件的 SBOM；照原本的 SBOM 比對，核心沒有比對"; rm -f "$OUT/scan/l4t-kernel-map.json"; fi;;
      *) status "$s1" "$s2" "$s3";;
    esac
  else status C-kernel-l4t-map FAIL "l4t_kernel.py 失敗：$(echo "$r" | tail -1)；照原本的 SBOM 比對"; rm -f "$OUT/scan/l4t-kernel-map.json"; fi
fi

# ---------- C. Grype（DB 線上更新後，比對在無網路沙箱內）、sbomgate、govulncheck ----------
GR=$OUT/scan/grype.json; DBST=FAIL
# 每次掃描前明確更新 Grype DB（GRYPE_DB_UPDATE=online 預設｜import:<鏡像檔案或 URL>｜off），在沙箱外；比對本身仍是 GRYPE_DB_AUTO_UPDATE=false
if have grype; then
  ur=$(grype_db_refresh grype "$OUT/scan"); UST=${ur%%$'\t'*}; status C-grype-db-update "$UST" "${ur#*$'\t'}"
  r=$(grype_db_eval grype "$OUT/scan" "${GRYPE_DB_MAX_AGE_DAYS:-1}" "$UST"); DBST=${r%%$'\t'*}; status C-grype-db "$DBST" "${r#*$'\t'}"
  META[grype_db_built]=$(sed -n 's/^Built:[[:space:]]*//p' "$OUT/scan/grype-db-status.txt"); META[grype_db_schema]=$(sed -n 's/^Schema:[[:space:]]*//p' "$OUT/scan/grype-db-status.txt")
  META[grype_db_update]=${GRYPE_DB_UPDATE:-online}; META[grype_db_update_status]=$UST
else status C-grype-db FAIL "找不到 grype"; fi
# 其他每日鏡像（DT 的 NVD、EUVD 等）的新鮮度：讀 sca-nvd-refresh 的狀態檔；MIRROR_REFRESH_STATUS 設成空字串＝不檢查（NOT_RUN，不是 OK）
mf=$(python3 -I "$ROOT/tools/pilot/lib/mirror_freshness.py" "${MIRROR_REFRESH_STATUS-/var/lib/sca-gitlab/refresh-status.tsv}" 2>/dev/null) || mf=
[ -n "$mf" ] || mf=$'GAP\t鏡像新鮮度檢查沒有輸出'
status C-mirror-freshness "${mf%%$'\t'*}" "${mf#*$'\t'}"
dbvalid=$(sed -n 's/^Status:[[:space:]]*//p' "$OUT/scan/grype-db-status.txt" 2>/dev/null)
if [ $SBOM_OK != 1 ]; then status C-grype NOT_RUN "沒有 SBOM"
elif [ "$dbvalid" != valid ]; then status C-grype NOT_RUN "Grype 資料庫不可用（見 C-grype-db）"
else
  runlog grype "$GR" "$OUT/scan/grype.stderr.txt" sbx -- GRYPE_DB_AUTO_UPDATE=false GRYPE_CHECK_FOR_APP_UPDATE=false "GRYPE_DB_CACHE_DIR=$GRYPE_DB_CACHE_DIR" \
    grype "sbom:$BOMW" -o json; x=$?; n=$(jlen "$GR" matches)
  if [ $x != 0 ]; then status C-grype FAIL "exit=$x $(tail -1 "$OUT/scan/grype.stderr.txt")"; rm -f "$GR"
  elif [ "$n" = x ]; then status C-grype FAIL "輸出無法解析"; rm -f "$GR"
  else status C-grype OK "$n matches（比對完成；不代表不存在其他弱點）"; fi
fi
KNONE=0      # 1＝給了 --kernel-in-other-report 而且 kernelcheck 判定這份 SBOM 沒有作業系統核心
# 作業系統核心的比對涵蓋（tools/pilot/lib/kernelcheck.py）：映像與 --sbom。SBOM 有核心（linux-kernel／linux-kernel-module 元件、
# Linux 核心 CPE 或核心套件）但 Grype 對核心 0 筆 → GAP（核心的 CVE 未評估）。沒有核心、沒有 SBOM（B 段已記）或原始碼模式
# 不寫這一列：一般容器映像本來就沒有核心，多一列 NOT_RUN 會讓整體退出碼從 0 變 2（同 C-govulncheck 只在 Go 專案出現）。
if [[ "$MODE" =~ ^(image|sbom)$ ]]; then
  if [ $SBOM_OK = 1 ]; then
    ka=(); [ -s "$GR" ] && ka=(--grype "$GR")
    [ -s "$OUT/scan/l4t-kernel-map.json" ] && ka+=(--kernel-map "$OUT/scan/l4t-kernel-map.json")   # 說明寫出比對對象是對應的 Canonical 核心
    [ -n "$KNOTDISTRO" ] && ka+=(--not-distro-kernel "$KNOTDISTRO")   # 平台宣告核心不是發行版的核心：有核心時 GAP
    r=$(python3 -I "$ROOT/tools/pilot/lib/kernelcheck.py" --sbom "$SBOM" "${ka[@]+"${ka[@]}"}" --out "$OUT/scan/kernel-coverage.json" 2>&1)
    l=$(printf '%s\n' "$r" | grep -m1 $'^C-kernel-coverage\t')
    if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"; [ "$s2" = NOT_RUN ] || status "$s1" "$s2" "$s3"
      # 分層：給了 --kernel-in-other-report 而且這份 SBOM 沒有核心（NOT_RUN）→ 核心階段不適用（見下面的 KNONE）
      [ "$s2" = NOT_RUN ] && [ -n "$KOTHER" ] && KNONE=1
    else status C-kernel-coverage FAIL "kernelcheck.py 失敗：$(echo "$r" | tail -1)"; fi
  fi
fi
# NVIDIA 安全公告（tools/pilot/lib/nvidia_bulletins.py，說明見 lib/nvidia-bulletins.md）：映像與 --sbom。SBOM 有 nvidia-l4t-* 套件
# （Jetson Linux）時，以人工對照表 lib/nvidia-bulletins.json 比較版本，只有已審核的列產生發現（source NVIDIA）。公告鏡像取自 PILOT_ENV 的
# NVIDIA_BULLETINS_MIRROR，沒有或過期 → GAP（無法確認對照表涵蓋最新公告）。不是 Jetson Linux（NOT_RUN）不寫這一列，同 C-kernel-coverage。
NVB=$OUT/scan/nvidia-bulletins.json
rm -f "$NVB"   # 同一個 --out 重跑：不留上一次的結果給 cra_report、report.py（這次沒有執行或失敗時）
if [[ "$MODE" =~ ^(image|sbom)$ ]] && [ $SBOM_OK = 1 ]; then
  na=(); [ -n "$NVIDIA_BULLETINS_MIRROR" ] && na=(--mirror "$NVIDIA_BULLETINS_MIRROR")
  r=$(python3 -I "$ROOT/tools/pilot/lib/nvidia_bulletins.py" match --sbom "$SBOM" --table "$ROOT/tools/pilot/lib/nvidia-bulletins.json" \
    "${na[@]+"${na[@]}"}" --out "$NVB" 2>&1)
  l=$(printf '%s\n' "$r" | grep -m1 $'^C-nvidia-bulletins\t')
  if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"
    case $s2 in NOT_RUN) rm -f "$NVB";; FAIL) rm -f "$NVB"; status "$s1" "$s2" "$s3";; *) status "$s1" "$s2" "$s3";; esac
  else rm -f "$NVB"; status C-nvidia-bulletins FAIL "nvidia_bulletins.py 失敗：$(echo "$r" | tail -1)"; fi
fi
# 規則 11：依生態系判斷鎖定檔（tools/pilot/lib/lockcheck.py）。每個偵測到的清單檔都要有對應的鎖定檔才宣告 full；
# 任一生態系缺鎖定檔 → unknown（sbomgate 最多 PARTIAL）。映像是「已安裝」的內容，沒有依賴解析問題，宣告 full。
tree=unknown; man=(); selfp=(); tnote=
if [ "$MODE" = image ]; then tree=full; tnote="（映像：已安裝套件即實際內容，--tree full；Syft 沒有辨識的檔案不在範圍內）"
elif [ "$MODE" = sbom ]; then tnote="（提供的 SBOM：依賴樹是否完整由提供者決定，--tree unknown）"
elif [ $SRC_OK = 1 ]; then
  if r=$(python3 -I "$ROOT/tools/pilot/lib/lockcheck.py" "$S" "$OUT/scan/lockfiles.json" 2>&1); then
    tree=${r%%$'\t'*}
    mapfile -t mfs < <(python3 -I -c 'import json,sys;[print(m) for m in json.load(open(sys.argv[1]))["manifests_for_sbomgate"]]' "$OUT/scan/lockfiles.json")
    for m in "${mfs[@]+"${mfs[@]}"}"; do man+=(--manifest "$S/$m"); done
    nc=$(python3 -I -c 'import json,sys;print("、".join(json.load(open(sys.argv[1]))["manifests_not_checked"]))' "$OUT/scan/lockfiles.json")
    eco=$(python3 -I -c 'import json,sys;print(json.load(open(sys.argv[1]))["summary"])' "$OUT/scan/lockfiles.json")
    detail="${r#*$'\t'}；${eco:-沒有清單檔}${nc:+；sbomgate 不支援、未比對內容的清單檔：$nc}"
    [ "$tree" = full ] && status C-lockfiles OK "$detail" || status C-lockfiles GAP "$detail（規則 11：依賴樹完整性未知）"
    tnote="（--tree $tree：${r#*$'\t'}）"
  else status C-lockfiles FAIL "lockcheck.py 失敗：$(echo "$r" | tail -1)"; fi
  mod=$(python3 -I -c 'import re,sys
for l in open(sys.argv[1],encoding="utf-8",errors="replace"):
    m=re.match(r"\s*module\s+(\S+)",l)
    if m: print(m.group(1).strip("\"")); break' "$S/go.mod" 2>/dev/null)
  [ -n "$mod" ] && selfp=(--self "pkg:golang/$mod")
  # 根目錄 composer.json／package.json 的 name：專案檔宣告的名稱（不可信），以 --self-hint 傳給 sbomgate——只排除對不上元件的
  # 無版本比對，不豁免元件，和元件同名時不採用（GitLab 實測：filamentphp/demo 的 composer.json name 是 laravel/laravel，
  # SBOM 主元件卻取自 package.json，Grype 對沒有版本的 laravel/laravel 套上同名套件的公告）。npm scoped 名稱要編碼（@ → %40）
  while IFS= read -r sp; do [ -n "$sp" ] && selfp+=(--self-hint "$sp"); done < <(python3 -I -c 'import json,sys,urllib.parse
for f, t in (("composer.json", "composer"), ("package.json", "npm")):
    try:
        n = json.load(open(sys.argv[1] + "/" + f, encoding="utf-8")).get("name")
    except (OSError, ValueError, AttributeError):
        continue
    if isinstance(n, str) and n.strip() and not any(c in n for c in "\n\r\t ?#"):
        print(f"pkg:{t}/" + urllib.parse.quote(n.strip(), safe="/"))' "$S" 2>/dev/null)
fi
META[dependency_tree]=$tree
# sbomgate（規則 11–14）：讀 $BOMW（Grype 比對的同一份；有 C-kernel-l4t-map 的元件時，對它的比對才不會被算成找不到元件）
if [ -s "$SBOM" ] && [ -s "$GR" ]; then
  python3 -I "$ROOT/tools/sbomgate/sbomgate.py" --sbom "$BOMW" --grype "$GR" "${man[@]}" "${selfp[@]}" --tree "$tree" --max-db-age-days "${GRYPE_DB_MAX_AGE_DAYS:-1}" \
    --out "$OUT/scan/sbomgate.json" > "$OUT/scan/sbomgate.txt" 2>&1; x=$?
  d=$(python3 -I -c 'import sys;print(open(sys.argv[1],encoding="utf-8",errors="replace").read().replace("\n"," ")[:300])' "$OUT/scan/sbomgate.txt")
  case $x in 0) status C-sbomgate OK "COMPLETE（只表示在這份 SBOM 與資料庫範圍內比對完成，不代表安全）$tnote";; 1) status C-sbomgate GAP "PARTIAL$tnote：$d";;
    2) status C-sbomgate NOT_ASSESSED "$d";; *) status C-sbomgate FAIL "exit=$x $d"; rm -f "$OUT/scan/sbomgate.json";; esac
elif [ -s "$SBOM" ]; then
  python3 -I "$ROOT/tools/sbomgate/sbomgate.py" --sbom "$BOMW" "${man[@]}" "${selfp[@]}" --tree "$tree" --out "$OUT/scan/sbomgate.json" > "$OUT/scan/sbomgate.txt" 2>&1; x=$?
  [ $x -le 2 ] && status C-sbomgate NOT_ASSESSED "沒有 Grype 結果，無法判斷比對完整性" || { status C-sbomgate FAIL "exit=$x"; rm -f "$OUT/scan/sbomgate.json"; }
else status C-sbomgate NOT_RUN "沒有 SBOM"; fi
# govulncheck：Go 專案（根目錄有 go.mod）。要連 vuln.go.dev，所以沙箱有網路，但根目錄唯讀、環境變數清空、秘密遮蔽
if [ "$MODE" != image ] && [ $SRC_OK = 1 ] && [ -f "$S/go.mod" ]; then
  if ! have govulncheck; then status C-govulncheck FAIL "Go 專案但找不到 govulncheck"
  elif [ $SBX_OK != 1 ]; then status C-govulncheck NOT_RUN "沙箱不可用"
  elif [ ! -f "$S/vendor/modules.txt" ] && [ $NETRES != 1 ]; then status C-govulncheck GAP "沒有 vendor/：govulncheck 需要下載模組，未允許連網解析（--allow-network-resolve）"
  else
    gv=$(tool_ver govulncheck); META[tool_govulncheck]=${gv:-未知}; want=$(echo "$pins" | tr ' ' '\n' | sed -n 's/^govulncheck=//p')
    [ -n "$want" ] && [ "$gv" != "$want" ] && status A-tools-govulncheck ATTENTION "govulncheck ${gv:-未知}≠install-tools.sh 的 $want"
    if [ -f "$S/vendor/modules.txt" ]; then genv=(GOFLAGS=-mod=vendor GOPROXY=off); else genv=(GOFLAGS=-mod=mod); fi
    runlog govulncheck "$OUT/scan/govulncheck.json" "$OUT/scan/govulncheck.stderr.txt" sbx --net --chdir "$S" -- \
      "${genv[@]}" GOTOOLCHAIN=local GOCACHE=/tmp/gocache GOPATH=/tmp/gopath govulncheck -format json ./...; gx=$?
    gn=$(govuln_count "$OUT/scan/govulncheck.json")
    if [ $gx != 0 ]; then status C-govulncheck FAIL "exit=$gx $(tail -1 "$OUT/scan/govulncheck.stderr.txt")"
    elif [ "$gn" = x ]; then status C-govulncheck FAIL "輸出無法解析或沒有 config"
    else status C-govulncheck OK "$gn 個 OSV ID（線上 vuln.go.dev$( [ -f "$S/vendor/modules.txt" ] || echo '；模組連網下載' )）"; fi
  fi
fi

# ---------- C3. 上傳用 SBOM（規則 13）：版本未知的元件移除版本後才上傳 DT 與 ScanCode.io；原始 SBOM 原樣保留 ----------
UPLOAD=$WORK/bom.upload.cdx.json
if [ $SBOM_OK = 1 ] && [ -s "$OUT/scan/sbomgate.json" ]; then
  if r=$(python3 -I "$ROOT/tools/pilot/lib/strip_versions.py" "$BOMW" "$OUT/scan/sbomgate.json" "$UPLOAD" 2>&1); then
    n=$(echo "$r" | grep -oE '[0-9]+' | head -1); META[upload_versions_removed]=${n:-0}
    if [ "${n:-0}" -gt 0 ]; then cp "$UPLOAD" "$OUT/sbom/sbom.upload.cdx.json"
      status C-upload-sbom OK "$r（規則 13：避免 DT 用範圍下限版本比對出誤報；上傳的是 sbom/sbom.upload.cdx.json，原始 SBOM 為 sbom/sbom.cdx.json）"
    else status C-upload-sbom OK "沒有版本未知的元件，上傳原始 SBOM"; fi
  else status C-upload-sbom FAIL "strip_versions.py 失敗：$(echo "$r" | tail -1)；不上傳"; UPLOAD=; fi
elif [ $SBOM_OK = 1 ]; then cp "$BOMW" "$UPLOAD"; status C-upload-sbom GAP "沒有 sbomgate 結果，無法判斷版本未知的元件：原樣上傳（DT 結果可能含範圍下限版本的誤報）"
else UPLOAD=; fi

# ---------- D. Dependency-Track 5.2.0 ----------
# 出處（DT 5.2.0 原始碼，tag 5.2.0）：
#   GET /api/v1/project/lookup?name=&version=（ProjectResource，VIEW_PORTFOLIO）；PUT /api/v1/project（PORTFOLIO_MANAGEMENT／_CREATE，已存在回 409）
#   POST /api/v1/bom multipart project、bom（BomResource.uploadBom，BOM_UPLOAD，回 {"token"}）
#   GET /api/v2/internal/workflow-runs?label=bom_upload_token=<token>（api/src/main/openapi/resources/internal/workflows/workflow-runs.yaml，
#     需 SYSTEM_CONFIGURATION 或 SYSTEM_CONFIGURATION_READ；import-bom、analyze-project、vuln-analysis 各一筆，0006 已觀察）
#   GET /api/v1/bom/token/{token}（BomResource.isTokenBeingProcessed，BOM_UPLOAD）只回「最後建立的那個 workflow」的狀態，無法分辨匯入與分析，
#     所以退回模式另以專案的 lastBomImport、lastVulnerabilityAnalysis（ReconcileVulnAnalysisResultsActivity 結束時 updateLastVulnAnalysis）確認。
#   GET /api/v1/finding/project/{uuid}（FindingResource，VIEW_VULNERABILITY；欄位含 epssScore、epssPercentile、isKev、aliases）→ dtread.py
#   前端專案頁：<DT_FRONTEND_URL>/projects/<uuid>（frontend 5.2.0 src/router/index.js，history 模式）
dt_http(){ local m=$1 p=$2 out=$3 c; shift 3; c=$(curl -sS -m 120 -X "$m" -H @"$DT_HDR" -o "$out" -w '%{http_code}' "$@" "$DT_URL$p" 2>>"$WORK/curl-dt.err"); echo "${c:-000}"; }
jget(){ python3 -I -c 'import json,sys
try:
    d=json.load(open(sys.argv[1]))
    for k in sys.argv[2].split("."): d=d[int(k)] if isinstance(d,list) else d[k]
    print("" if d is None else d)
except Exception: print("")' "$1" "$2"; }
DT_UUID=; DT_SKIP=
[ $NOUP = 1 ] && DT_SKIP="--no-upload"
[ -z "$DT_SKIP" ] && [ $HAVE_ENV != 1 ] && DT_SKIP="沒有 $PILOT_ENV"
[ -z "$DT_SKIP" ] && { [ -n "$DT_URL" ] && [ -n "$DT_API_KEY" ] || DT_SKIP="pilot.env 缺 DT_URL 或 DT_API_KEY"; }
[ -z "$DT_SKIP" ] && [ -z "$UPLOAD" ] && DT_SKIP="沒有可上傳的 SBOM"
if [ -n "$DT_SKIP" ]; then for s in C-dt-feeds D-dt-data-sources D-dt-kev-sources D-dt-osv-coverage D-dt-project D-dt-upload D-dt-bom-processing D-dt-vuln-analysis D-dt-findings; do status "$s" NOT_RUN "$DT_SKIP"; done
else
  O=$OUT/dt
  curl -sS -m 30 -o "$O/version.json" "$DT_URL/api/version" 2>>"$WORK/curl-dt.err"; META[dt_version]=$(jget "$O/version.json" version)
  # 資料源狀態（tools/pilot/lib/dtsources.py 的出處）：在上傳前讀，NVD 或 OSV 最近一次 mirror 不是 COMPLETED → D-dt-data-sources GAP，
  # compare_expected 與報告把 DT 的弱點結果當作不完整。KEV（CISA、ENISA）另記 D-dt-kev-sources。
  # C-dt-feeds：同一批回應判斷 DT 資料源（NVD、OSV、CISA、ENISA；GitHub 關閉不看）最近一次是否 COMPLETED 且在 DT_FEEDS_MAX_AGE_HOURS（預設 26）小時內；沒有 SYSTEM_CONFIGURATION_READ → NOT_RUN。
  srcargs=()
  for ks in vuln:nvd vuln:osv kev:cisa kev:enisa; do k=${ks%%:*}; n=${ks#*:}
    c=$(dt_http GET "/api/v2/$k-data-sources/$n/mirror-runs/latest" "$WORK/mirror-$k-$n.json"); srcargs+=("$k:$n:$c:$WORK/mirror-$k-$n.json"); done
  # OSV 啟用的生態系 vs SBOM 的 purl 類型（D-dt-osv-coverage）：沒有啟用的生態系在 DT 只能經 NVD（CPE）比對
  c=$(dt_http GET /api/v2/extension-points/vuln-data-source/extensions/osv/config "$WORK/osv-config.json")
  # NVD 鏡像模式（pilot.env 的 PILOT_NVD_MIRROR=1）：鏡像 modified 過期或未知 → D-dt-data-sources GAP（dtsources.py）
  [ -n "$PILOT_NVD_MIRROR" ] && srcargs=(--nvd-mirror "$PILOT_NVD_MIRROR|$NVD_MIRROR_MODIFIED" "${srcargs[@]}")
  # DT 的 ENISA KEV 讀哪一份檔（上游 eukev.json 2026-08-13 後沒有更新）：不是 EUVD 產生的檔、或那份檔過期 → D-dt-kev-sources GAP，
  # DT 的 ENISA mirror COMPLETED 也一樣（dtsources.py 的說明；新舊以 EUVD_MIRROR 的 dt-feeds/kev/euvd/SOURCE.json 判斷）
  c2=$(dt_http GET /api/v2/extension-points/kev-data-source/extensions/enisa/config "$WORK/enisa-config.json")
  srcargs=(--enisa-config "$c2:$WORK/enisa-config.json" --euvd-kev "$EUVD_MIRROR" "${srcargs[@]}")
  if r=$(python3 -I "$ROOT/tools/pilot/lib/dtsources.py" "$O/data-sources.json" --osv-config "$c:$WORK/osv-config.json" --sbom "$UPLOAD" "${srcargs[@]}" 2>&1); then
    while IFS=$'\t' read -r s1 s2 s3; do [ -n "$s1" ] && status "$s1" "$s2" "$s3"; done <<< "$r"
    META[dt_data_sources]=$(jget "$O/data-sources.json" vuln_status)
  else status D-dt-data-sources FAIL "dtsources.py 失敗：$(echo "$r" | tail -1)"; status D-dt-kev-sources NOT_RUN "dtsources.py 失敗"; status C-dt-feeds NOT_RUN "dtsources.py 失敗"; status D-dt-osv-coverage NOT_RUN "dtsources.py 失敗"; fi
  q=$(python3 -I -c 'import sys,urllib.parse as u;print(u.urlencode({"name":sys.argv[1],"version":sys.argv[2]}))' "$NAME" "${META[version]}")
  c=$(dt_http GET "/api/v1/project/lookup?$q" "$O/project.json")
  if [ "$c" = 404 ]; then
    body=$(python3 -I -c 'import json,sys;print(json.dumps({"name":sys.argv[1],"version":sys.argv[2],"active":True}))' "$NAME" "${META[version]}")
    c=$(dt_http PUT /api/v1/project "$O/project.json" -H 'Content-Type: application/json' --data "$body")
    [ "$c" = 409 ] && c=$(dt_http GET "/api/v1/project/lookup?$q" "$O/project.json")   # 同時有人建立
    how=建立
  else how=沿用; fi
  DT_UUID=$(jget "$O/project.json" uuid)
  if [[ "$c" =~ ^20[01]$ ]] && [ -n "$DT_UUID" ]; then status D-dt-project OK "$how $NAME@${META[version]}（$DT_UUID；DT ${META[dt_version]:-版本未知}）"
    META[dt_project_uuid]=$DT_UUID; [ -n "$DT_FRONTEND_URL" ] && META[dt_project_url]=$DT_FRONTEND_URL/projects/$DT_UUID
  else status D-dt-project FAIL "http=$c（DT_URL=$DT_URL）"; DT_UUID=; fi
  if [ -z "$DT_UUID" ]; then for s in D-dt-upload D-dt-bom-processing D-dt-vuln-analysis D-dt-findings; do status "$s" NOT_RUN "沒有 DT 專案"; done
  else
    dt_http GET "/api/v1/project/$DT_UUID" "$O/project.before.json" > /dev/null
    pb_imp=$(jget "$O/project.before.json" lastBomImport); pb_va=$(jget "$O/project.before.json" lastVulnerabilityAnalysis)
    # Debian／Ubuntu：補上原始碼套件元件，只給 DT（lib/deb_sources.py 的說明：Ubuntu 漏洞資料以原始碼套件名稱記錄，
    # 二進位名稱不同的套件 DT 比對不到）。沒有 deb 元件時不寫這一列；失敗時照原本的 SBOM 上傳並記 FAIL。
    DT_UP=$UPLOAD
    r=$(python3 -I "$ROOT/tools/pilot/lib/deb_sources.py" "$UPLOAD" "$WORK/bom.dt.cdx.json" "$O/deb-sources.json" 2>&1)
    case ${r%%$'\t'*} in
      OK) DT_UP=$WORK/bom.dt.cdx.json; status D-dt-deb-sources OK "${r#*$'\t'}（dt/deb-sources.json）";;
      NOT_RUN) rm -f "$O/deb-sources.json";;
      *) status D-dt-deb-sources FAIL "deb_sources.py：$(echo "$r" | tail -1)；改上傳沒有原始碼套件的 SBOM，二進位名稱不同的 deb 套件 DT 比對不到";;
    esac
    c=$(dt_http POST /api/v1/bom "$O/bom-upload.json" -F "project=$DT_UUID" -F "bom=@$DT_UP;type=application/json")
    tok=$(jget "$O/bom-upload.json" token)
    if [ "$c" != 200 ] || [ -z "$tok" ]; then status D-dt-upload FAIL "http=$c $(head -c 200 "$O/bom-upload.json" 2>/dev/null)"
      status D-dt-bom-processing NOT_RUN "上傳失敗"; status D-dt-vuln-analysis NOT_RUN "上傳失敗"; status D-dt-findings NOT_RUN "上傳失敗"
    else
      status D-dt-upload OK "http=200 token=$tok"; META[dt_bom_token]=$tok
      lim=${DT_WAIT_SECONDS:-900}; t0=$(date +%s); mode=; st=; imp=; va=; va_t=
      while :; do
        if [ "$mode" != fallback ]; then
          c=$(dt_http GET "/api/v2/internal/workflow-runs?label=bom_upload_token%3D$tok&limit=100" "$O/workflow-runs.json")
          if [ "$c" = 200 ]; then mode=workflow; st=$(dt_workflow_status "$O/workflow-runs.json" "$tok")
            echo "$st" | grep -qE "import-bom=(FAILED|CANCELLED)" && break
            echo "$st" | grep -qE "vuln-analysis=(FAILED|CANCELLED)" && break
            # analyze-project（AnalyzeProjectWorkflow）＝vuln-analysis → 政策評估 → 專案 metrics；findings 在 vuln-analysis 完成後即可讀，
            # 但多等 analyze-project 最多 DT_POLICY_WAIT_SECONDS（預設 120）秒，讓政策評估也完成
            echo "$st" | grep -qE "analyze-project=(COMPLETED|FAILED|CANCELLED)" && echo "$st" | grep -q "vuln-analysis=COMPLETED" && break
            if echo "$st" | grep -q "vuln-analysis=COMPLETED"; then
              echo "$st" | grep -q "analyze-project=" || break
              [ -z "$va_t" ] && va_t=$(date +%s)
              [ $(( $(date +%s) - va_t )) -ge "${DT_POLICY_WAIT_SECONDS:-120}" ] && break
            fi
          elif [ "$c" = 401 ] || [ "$c" = 403 ]; then mode=fallback; echo "workflow-runs http=$c：改用 bom/token＋專案時間" > "$O/workflow-mode.txt"
          fi
        fi
        if [ "$mode" = fallback ]; then
          dt_http GET "/api/v1/bom/token/$tok" "$O/bom-token.json" > /dev/null; dt_http GET "/api/v1/project/$DT_UUID" "$O/project.after.json" > /dev/null
          pr=$(jget "$O/bom-token.json" processing); ts=$(jget "$O/bom-token.json" status)
          imp=$(jget "$O/project.after.json" lastBomImport); va=$(jget "$O/project.after.json" lastVulnerabilityAnalysis)
          st="token processing=$pr status=$ts；lastBomImport ${pb_imp:-無}→${imp:-無}；lastVulnerabilityAnalysis ${pb_va:-無}→${va:-無}"
          [ "$ts" = FAILED ] && break
          [ "$pr" = False ] || [ "$pr" = false ] && [ -n "$va" ] && [ "$va" != "$pb_va" ] && [ -n "$imp" ] && [ "$imp" != "$pb_imp" ] && break
        fi
        [ $(( $(date +%s) - t0 )) -ge "$lim" ] && { st="$st（等待 ${lim} 秒逾時）"; break; }
        sleep 3
      done
      echo "$(now) mode=$mode $st" > "$O/workflow-status.txt"
      if [ "$mode" = workflow ]; then
        echo "$st" | grep -q "import-bom=COMPLETED" && status D-dt-bom-processing OK "$st" || status D-dt-bom-processing FAIL "$st"
        apn=; echo "$st" | grep -q "analyze-project=COMPLETED" || apn="（analyze-project 未完成：政策評估與專案 metrics 尚未完成；findings 是 vuln-analysis 完成後讀的）"
        echo "$st" | grep -q "vuln-analysis=COMPLETED" && status D-dt-vuln-analysis OK "$st$apn" || status D-dt-vuln-analysis FAIL "$st"
      elif [ "$mode" = fallback ]; then
        note="（金鑰沒有 SYSTEM_CONFIGURATION_READ，改看專案時間）"
        [ -n "$imp" ] && [ "$imp" != "$pb_imp" ] && status D-dt-bom-processing OK "$st$note" || status D-dt-bom-processing FAIL "$st$note"
        [ -n "$va" ] && [ "$va" != "$pb_va" ] && [ "$ts" != FAILED ] && status D-dt-vuln-analysis OK "$st$note" || status D-dt-vuln-analysis FAIL "$st$note"
      else status D-dt-bom-processing FAIL "讀不到處理狀態（workflow-runs http=$c）"; status D-dt-vuln-analysis FAIL "讀不到處理狀態"; fi
      if r=$(DT=$DT_URL DT_API_KEY=$DT_API_KEY python3 -I "$ROOT/tools/e2e/dtread.py" findings "$DT_UUID" "$O/findings.json" 2>&1); then
        k=$(python3 -I -c 'import json,sys;d=json.load(open(sys.argv[1]));print(sum(1 for f in d if f["vulnerability"].get("isKev")),sum(1 for f in d if f["vulnerability"].get("epssScore") is not None))' "$O/findings.json" 2>/dev/null)
        if [ "${META[dt_data_sources]}" = OK ]; then status D-dt-findings OK "$r（KEV ${k%% *}、有 EPSS ${k##* }；含 suppressed）"
        else status D-dt-findings GAP "讀取完成：$r（KEV ${k%% *}、有 EPSS ${k##* }；含 suppressed）；但弱點資料源不完整或狀態未知（D-dt-data-sources=${META[dt_data_sources]:-未讀}），DT 的弱點結果不完整"; fi
      else status D-dt-findings FAIL "$(echo "$r" | tail -1)"; fi
    fi
  fi
fi
# 發行版再判（tools/pilot/lib/distro_recheck.py）：Debian／Ubuntu 套件上只經 NVD（或 GitHub、非發行版的 OSV）比對到、Grype 沒有比對到的
# DT 發現，以發行版自己的 OSV 紀錄（PILOT_ENV 的 OSV_DISTRO_MIRROR，tools/mirror/osv-distro.sh 的輸出）再判，寫 scan/distro-recheck.json
# （cra_report.py 把「發行版已修補」的列移出 P1–P3）。原始的 dt/findings.json 不改。要在 D-dt-findings 之後（要 DT 的 findings），
# C-grype 的結果已經寫好（Grype 比對到的不再判）。沒有要再判的列（NOT_RUN）不寫這一列；鏡像沒有、過期或不完整 → GAP（沒有判定）。
DRC=$OUT/scan/distro-recheck.json
rm -f "$DRC" "$DRC.xz"   # 同一個 --out 重跑：不留上一次的結果給 cra_report（這次沒有執行或失敗時；cra_report 也讀 .xz）
dtf=$(awk -F'\t' '$1=="D-dt-findings"{s=$2} END{print s}' "$ST")
if [[ "$dtf" =~ ^(OK|GAP)$ ]] && [ -s "$OUT/dt/findings.json" ]; then   # findings 讀取完成（GAP＝資料源不完整，但清單是完整讀回的）
  da=(); [ -s "$GR" ] && da+=(--grype "$GR"); [ -s "${SBOM:-}" ] && da+=(--sbom "$SBOM")
  [ -s "$OUT/dt/deb-sources.json" ] && da+=(--deb-sources "$OUT/dt/deb-sources.json")
  [ -s "$OUT/scan/l4t-kernel-map.json" ] && da+=(--kernel-map "$OUT/scan/l4t-kernel-map.json")
  [ -n "$OSV_DISTRO_MIRROR" ] && da+=(--mirror "$OSV_DISTRO_MIRROR")
  r=$(timeout 900 python3 -I "$ROOT/tools/pilot/lib/distro_recheck.py" --findings "$OUT/dt/findings.json" "${da[@]+"${da[@]}"}" --out "$DRC" 2>&1)
  l=$(printf '%s\n' "$r" | grep -m1 $'^D-distro-recheck\t')
  if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"
    case $s2 in NOT_RUN) rm -f "$DRC";; FAIL) rm -f "$DRC"; status "$s1" "$s2" "$s3";; *) status "$s1" "$s2" "$s3";; esac
  else rm -f "$DRC"; status D-distro-recheck FAIL "distro_recheck.py 失敗（或超過 900 秒）：$(echo "$r" | tail -1)"; fi
fi
# USN → CVE（tools/pilot/lib/usn_cves.py）：DT 的 OSV 資料裡沒有 CVE 別名的 USN，從同一個 Ubuntu OSV 鏡像查它列的 CVE
# （upstream、aliases；不用 related），寫 scan/usn-cves.json（含鏡像的來源資料）。cra_report.py 用它把 USN 併進同一個元件版本上
# 那個 CVE 的列。沒有這種 USN → 不寫這一列；沒有鏡像或過期 → NOT_RUN（檔案記原因，USN 照舊各自成列）。
UC=$OUT/scan/usn-cves.json
rm -f "$UC" "$UC.xz"   # 同一個 --out 重跑：不留上一次的對應
if [[ "$dtf" =~ ^(OK|GAP)$ ]] && [ -s "$OUT/dt/findings.json" ]; then
  ua=(); [ -n "$OSV_DISTRO_MIRROR" ] && ua+=(--mirror "$OSV_DISTRO_MIRROR")
  r=$(timeout 600 python3 -I "$ROOT/tools/pilot/lib/usn_cves.py" --findings "$OUT/dt/findings.json" "${ua[@]+"${ua[@]}"}" --out "$UC" 2>&1)
  l=$(printf '%s\n' "$r" | grep -m1 $'^D-usn-cves\t')
  if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"
    case $s2 in NOT_RUN) [ -s "$UC" ] && status "$s1" "$s2" "$s3";; FAIL) rm -f "$UC"; status "$s1" "$s2" "$s3";; *) status "$s1" "$s2" "$s3";; esac
  else rm -f "$UC"; status D-usn-cves FAIL "usn_cves.py 失敗（或超過 600 秒）：$(echo "$r" | tail -1)"; fi
fi
# Ubuntu priority（tools/pilot/lib/ubuntu_priority.py）：Ubuntu 套件（含 Canonical 核心）上的 CVE，從同一個 Ubuntu OSV 鏡像讀
# UBUNTU-CVE-<CVE> 的 Ubuntu priority，寫 scan/ubuntu-priority.json。cra_report.py 分級的嚴重度依供應商評級優先（NVIDIA 公告 → Ubuntu priority
# → NVD）。沒有 Ubuntu 套件上的 CVE → 不寫這一列；沒有鏡像或過期 → NOT_RUN（檔案記原因；嚴重度照 Grype 的 Ubuntu 比對或 DT／NVD）。
UP=$OUT/scan/ubuntu-priority.json
rm -f "$UP" "$UP.xz"   # 同一個 --out 重跑：不留上一次的結果
if [[ "$dtf" =~ ^(OK|GAP)$ ]] && [ -s "$OUT/dt/findings.json" ]; then
  pa=(); [ -n "$OSV_DISTRO_MIRROR" ] && pa+=(--mirror "$OSV_DISTRO_MIRROR")
  r=$(timeout 600 python3 -I "$ROOT/tools/pilot/lib/ubuntu_priority.py" --findings "$OUT/dt/findings.json" "${pa[@]+"${pa[@]}"}" --out "$UP" 2>&1)
  l=$(printf '%s\n' "$r" | grep -m1 $'^D-ubuntu-priority\t')
  if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"
    case $s2 in NOT_RUN) [ -s "$UP" ] && status "$s1" "$s2" "$s3";; FAIL) rm -f "$UP"; status "$s1" "$s2" "$s3";; *) status "$s1" "$s2" "$s3";; esac
  else rm -f "$UP"; status D-ubuntu-priority FAIL "ubuntu_priority.py 失敗（或超過 600 秒）：$(echo "$r" | tail -1)"; fi
fi
# Ubuntu CVE Tracker 的狀態（tools/pilot/lib/ubuntu_status.py）：DT findings 裡 Ubuntu 套件（核心以外）上的 (CVE, 原始碼套件, 發行版)，
# 從 Tracker 狀態鏡像（PILOT_ENV 的 UBUNTU_CVE_STATUS_MIRROR）只取出這個映像要的，寫 scan/ubuntu-status.json（cra_report 的證據規則 U1：
# Ubuntu 標 not-affected、安裝的版本符合註記 → not_affected）。沒有 Ubuntu 套件上的 CVE → 不寫這一列；沒有鏡像或過期 → NOT_RUN
# （檔案記原因；U1 不套用，列照樣受影響）。
US=$OUT/scan/ubuntu-status.json
rm -f "$US" "$US.xz"   # 同一個 --out 重跑：不留上一次的結果
if [[ "$dtf" =~ ^(OK|GAP)$ ]] && [ -s "$OUT/dt/findings.json" ]; then
  sa=(); [ -s "${SBOM:-}" ] && sa+=(--sbom "$SBOM"); [ -n "$UBUNTU_CVE_STATUS_MIRROR" ] && sa+=(--mirror "$UBUNTU_CVE_STATUS_MIRROR"); [ -n "$PYVERS" ] && sa+=(--py-versions "$PYVERS")
  r=$(timeout 600 python3 -I "$ROOT/tools/pilot/lib/ubuntu_status.py" --findings "$OUT/dt/findings.json" "${sa[@]+"${sa[@]}"}" --out "$US" 2>&1)
  l=$(printf '%s\n' "$r" | grep -m1 $'^D-ubuntu-status\t')
  if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"
    case $s2 in NOT_RUN) [ -s "$US" ] && status "$s1" "$s2" "$s3";; FAIL) rm -f "$US"; status "$s1" "$s2" "$s3";; *) status "$s1" "$s2" "$s3";; esac
  else rm -f "$US"; status D-ubuntu-status FAIL "ubuntu_status.py 失敗（或超過 600 秒）：$(echo "$r" | tail -1)"; fi
fi
# 核心 config 過濾（tools/pilot/lib/kernel_config.py）：映像與 --sbom。核心元件（C-kernel-l4t-map 加上的 Canonical 核心等）上的 CVE，
# 以 Linux 核心 CNA 紀錄的 programFiles（PILOT_ENV 的 KERNEL_CVE_MIRROR，tools/mirror/kernel-cve.sh 的輸出）對照產品核心的 .config
# 與 Makefile（映像裡 /usr/src/linux-headers-<版本>/），判斷修補的程式有沒有編進核心，寫 scan/kernel-config.json。
# 放在 D-dt-findings 之後：CVE 清單取 Grype 與 DT 兩邊（C-kernel-coverage 之後，Grype 的結果已經寫好）。只列出，原始的發現不改。
# 建置設定的來源：--kernel-build（rootfs tar、資料夾，或刷機包＋--kernel-build-prefix）；--image 沒給時用 docker save 的映像 tar。
# --sbom 沒給 --kernel-build 時不執行，記 NOT_RUN；沒有核心的 CVE（kernel_config.py 回 NOT_RUN）不寫這一列；沒有 .config、版本不符、
# CNA 鏡像沒有或過期 → GAP（沒有判定，清單不變）。
# 接著是模組對應（tools/pilot/lib/kernel_module_map.py，C-kernel-module-map，scan/kernel-module-map.json）：同樣的輸入，
# 每個核心 CVE 的 programFiles 依 Kbuild 規則對應到 builtin／模組（.ko 名稱，與 modules.order／modules.builtin 核對）／沒編／unknown。
# 只對應，不判定；K2（模組移除或停用）讀這個檔。NOT_RUN（沒有核心的 CVE）不寫這一列；沒有模組目錄或模組清單 → GAP（照列，K2 不採用）。
KCF=$OUT/scan/kernel-config.json
KMM=$OUT/scan/kernel-module-map.json
rm -f "$KCF" "$KCF.xz"   # 同一個 --out 重跑：不留上一次的結果給 VEX 匯出（這次沒有執行或失敗時）
rm -f "$KMM" "$KMM.xz"
rm -f "$OUT/scan/kernel-cve-list.txt" "$OUT/scan/kernel-cve-list.json"   # 同一個 --out 重跑：不留上一次的核心 CVE 清單（cra_report 會讀）
KSRC=(); KLABEL=; KREC=(); KCVL=; KPREF=()
KVF=$OUT/scan/kernel-versions.json
rm -f "$KVF"   # 同一個 --out 重跑：不留上一次的出貨核心清單給 cra_report
KVMULTI=0; KVARGS=(); KVACT=0
# 核心建置紀錄（環境變數 KERNEL_BUILD_RECORD，選用）：只給 kernel_config.py（kernel_module_map.py 不讀）；不存在等問題由 kernel_config.py 記 GAP
[ -n "${KERNEL_BUILD_RECORD:-}" ] && KREC=(--build-record "$(readlink -m -- "$KERNEL_BUILD_RECORD")")
# 樹外模組的建置紀錄（環境變數 KERNEL_OOT_BUILD_RECORDS，選用；用冒號分隔多個資料夾）：給 kernel_config.py 的 --oot-build-record（可重複）。
# 標頭檔只有在「核心與所有樹外 .ko 的紀錄都沒有列它」而且映像每個樹外 .ko 都有紀錄時，才不因為樹外模組而 unknown。需要 KERNEL_BUILD_RECORD。
if [ -n "${KERNEL_OOT_BUILD_RECORDS:-}" ]; then
  IFS=: read -r -a _oot <<< "$KERNEL_OOT_BUILD_RECORDS"
  for _d in "${_oot[@]}"; do [ -n "$_d" ] && KREC+=(--oot-build-record "$(readlink -m -- "$_d")"); done
fi
# 本機 linux-stable 的 clone（環境變數 KERNEL_STABLE_GIT，選用，唯讀、不 fetch）：給 kernel_config.py 的 --stable-git
[ -n "${KERNEL_STABLE_GIT:-}" ] && KREC+=(--stable-git "$(readlink -m -- "$KERNEL_STABLE_GIT")")
if [ -n "$KBUILD" ]; then KSRC=(--from "$KBUILD"); [ -n "$KBUILD_PREFIX" ] && KSRC+=(--prefix "$KBUILD_PREFIX"); KLABEL="--kernel-build"
elif [ "$MODE" = image ] && [ -s "${IMG_TAR:-}" ]; then KSRC=(--from "$IMG_TAR"); KLABEL="映像"; fi
# 核心原始碼樹（環境變數 KERNEL_SOURCE_DIR，選用）：Makefile／Kbuild 的來源；放進 KSRC，C-kernel-config 與 C-kernel-module-map 都收到
[ -n "${KERNEL_SOURCE_DIR:-}" ] && [ ${#KSRC[@]} -gt 0 ] && KSRC+=(--source-tree "$(readlink -m -- "$KERNEL_SOURCE_DIR")")
# Grype、DT 都沒有核心元件的 CVE（廠商核心不是套件）時的核心 CVE 清單：KERNEL_CVES（明確給的清單），或依產品核心版本從 CNA 鏡像產生。
# 成功 → 設 KCVL（清單檔）與 KCVO（來源說明），回傳 0；其他（版本取不到、被拒絕、沒有清單來源、產生失敗）→ 寫 GAP／NOT_RUN 的狀態列，回傳 1；
# 映像裡看不到核心（沒有模組資料夾也沒有 Image）→ 回傳 2，什麼都不寫（沒有核心可評估）。
kernel_cve_list(){
  local kl=$OUT/scan/kernel-cve-list.txt kj=$OUT/scan/kernel-cve-list.json pr ps pv pt cr cs ct cl
  rm -f "$kl" "$kj"
  if [ -n "${KERNEL_CVES:-}" ]; then
    if [ -r "$KERNEL_CVES" ] && [ -f "$KERNEL_CVES" ] && grep -Eq 'CVE-[0-9]{4}-[0-9]{4,}' -- "$KERNEL_CVES"; then
      grep -Eo 'CVE-[0-9]{4}-[0-9]{4,}' -- "$KERNEL_CVES" | LC_ALL=C sort -u > "$kl"
      KCVL=$kl; KCVO="KERNEL_CVES（明確給的清單）"
      status C-kernel-cve-list OK "核心 CVE 清單 $(wc -l < "$kl") 個，來自 KERNEL_CVES（明確給的清單；sha256 $(sha256sum "$kl" | cut -c1-12)…）：不是 Grype／DT，也不是 CNA 版本比對"
      return 0
    fi
    status C-kernel-cve-list GAP "KERNEL_CVES 讀不到、不是檔案，或裡面沒有 CVE 編號：核心的 CVE 沒有依 .config 判定"
    status C-kernel-config GAP "KERNEL_CVES 不能用：核心的 CVE 沒有依 .config 判定（來源：$KLABEL）"
    status C-kernel-module-map GAP "KERNEL_CVES 不能用：核心的 CVE 沒有對應到模組（來源：$KLABEL）"
    return 1
  fi
  if [ "${KVERS[*]+x}" = x ] && [ ${#KVERS[@]} -eq 1 ]; then pr=$'KERNEL-VERSION\tOK\t'"${KVERS[0]}"      # 剛好指定 1 顆：用它，不探測
  else
    pr=$(timeout 3600 python3 -I "$ROOT/tools/pilot/lib/kernel_config.py" --probe-kernel-version --also-list-kernel-versions "${KSRC[@]}" "${KPREF[@]+"${KPREF[@]}"}" 2>&1)
    kernel_ship_from "$pr"
    pr=$(printf '%s\n' "$pr" | grep -m1 $'^KERNEL-VERSION\t')
  fi
  if [ -z "$pr" ]; then
    status C-kernel-cve-list GAP "Grype、DT 都沒有核心 CVE，產品核心版本讀不出來（kernel_config.py --probe-kernel-version 失敗或超過 3600 秒；來源：$KLABEL）：不猜"
    status C-kernel-config GAP "沒有核心 CVE 清單（核心版本讀不出來）：核心的 CVE 沒有依 .config 判定（來源：$KLABEL）"
    status C-kernel-module-map GAP "沒有核心 CVE 清單（核心版本讀不出來）：核心的 CVE 沒有對應到模組（來源：$KLABEL）"
    return 1
  fi
  IFS=$'\t' read -r _ ps pv <<< "$pr"
  case $ps in
    NONE) return 2;;
    OK) :;;
    *) status C-kernel-cve-list GAP "Grype、DT 都沒有核心 CVE，產品核心版本不能確定：$pv（來源：$KLABEL）：不猜，核心的 CVE 沒有依 .config 判定"
       status C-kernel-config GAP "沒有核心 CVE 清單（核心版本不能確定：$pv）：核心的 CVE 沒有依 .config 判定（來源：$KLABEL）"
       status C-kernel-module-map GAP "沒有核心 CVE 清單（核心版本不能確定）：核心的 CVE 沒有對應到模組（來源：$KLABEL）"
       return 1;;
  esac
  if [ -z "$KERNEL_CVE_MIRROR" ]; then
    status C-kernel-cve-list NOT_RUN "Grype、DT 都沒有核心 CVE，核心 $pv 的 CVE 清單沒有來源：沒有 KERNEL_CVE_MIRROR（CNA 鏡像），也沒有 KERNEL_CVES"
    status C-kernel-config NOT_RUN "核心 $pv 沒有核心 CVE 清單：核心的 CVE 沒有依 .config 判定（來源：$KLABEL）"
    status C-kernel-module-map NOT_RUN "核心 $pv 沒有核心 CVE 清單：核心的 CVE 沒有對應到模組（來源：$KLABEL）"
    return 1
  fi
  cr=$(timeout 600 python3 -I "$ROOT/tools/pilot/lib/kernel_cna_version.py" --kernel-version "$pv" --mirror "$KERNEL_CVE_MIRROR" --out "$kj" --cves-out "$kl" 2>&1)
  cl=$(printf '%s\n' "$cr" | grep -m1 $'^KERNEL-CNA-VERSION\t')
  if [ -z "$cl" ] || [ ! -s "$kl" ]; then
    rm -f "$kl" "$kj"
    ct=${cl:+$(printf '%s' "$cl" | cut -f2- | tr '\t' ' ')}
    status C-kernel-cve-list GAP "核心 $pv 的 CVE 清單不能依 CNA 版本比對產生（${ct:-kernel_cna_version.py 失敗或超過 600 秒}）：不猜，核心的 CVE 沒有依 .config 判定"
    status C-kernel-config GAP "沒有核心 CVE 清單（CNA 版本比對失敗）：核心的 CVE 沒有依 .config 判定（來源：$KLABEL）"
    status C-kernel-module-map GAP "沒有核心 CVE 清單（CNA 版本比對失敗）：核心的 CVE 沒有對應到模組（來源：$KLABEL）"
    return 1
  fi
  IFS=$'\t' read -r _ cs ct <<< "$cl"
  KCVL=$kl; KCVO="kernel-cna-version（核心 $pv）"
  status C-kernel-cve-list "$cs" "核心 $pv 的 CVE 清單 $(wc -l < "$kl") 個，由 Linux 核心 CNA 的版本範圍比對產生（kernel_cna_version.py），不是 Grype／DT：$ct"
  return 0
}
# 映像出貨的核心與 --kernel-version（scan/kernel-versions.json，tools/pilot/lib/kernel_versions.py）：一個映像可以有不只一顆核心（例如 Raspberry Pi
# 有 Pi 5 與 Pi 4 兩個 /usr/lib/modules/<版本>/）。出貨但沒被判定的核心不可以靜默不見：每一顆記一列 C-kernel-not-judged-<版本>（GAP），
# C-kernel-config 與 C-kernel-module-map 至少 GAP，檔案寫 shipped（映像的清單）、requested（指定的）、judged（交給判定工具的）、not_judged（附原因）。
# 指定剛好 1 顆：判定那一顆（--kernel-version 原樣交給 kernel_config.py、kernel_module_map.py，核心 CVE 清單也用它、不探測）。
# 指定 2 顆以上：多顆核心逐一判定還沒實作（M2 之後）→ 一顆都不判定（KVMULTI=1），兩個階段 GAP。沒指定：映像只有 1 顆就照舊；有多顆照舊 GAP（工具不猜）。
# 映像出貨的核心（KSHIP 陣列、KSHIP_OK＝1 表示讀到了）不另外讀一次映像（刷機包 tbz2 要解壓好幾分鐘）：判定工具與 --probe-kernel-version
# 帶 --also-list-kernel-versions，讀映像的同一趟順便印一行 KERNEL-VERSIONS，由 kernel_ship_from 收；都沒讀到映像時（指定 2 顆以上、
# 沒有核心 CVE 所以工具沒讀映像…）kernel_versions_finish 才用 --list-kernel-versions 補讀一次。
kernel_ship_from(){   # $1：工具的輸出；只收第一次讀到的
  local l s2 s3
  [ "$KSHIP_OK" = 1 ] && return 0
  l=$(printf '%s\n' "$1" | grep -m1 $'^KERNEL-VERSIONS\t')
  if [ -n "$l" ]; then IFS=$'\t' read -r _ s2 s3 <<< "$l"; [ "$s2" = OK ] && { KSHIP_OK=1; read -r -a KSHIP <<< "$s3"; }; fi
  return 0
}
# 準備：設 KVMULTI、KVARGS（要交給判定工具的 --kernel-version）。
kernel_versions_prepare(){
  KVMULTI=0; KVARGS=(); KSHIP=(); KSHIP_OK=0
  if [ "${KVERS[*]+x}" = x ]; then
    [ ${#KVERS[@]} -ge 2 ] && KVMULTI=1
    [ ${#KVERS[@]} -eq 1 ] && KVARGS=(--kernel-version "${KVERS[0]}")
  fi
  KVACT=1
  return 0
}
# 狀態列至少 GAP：$1 階段、$2 前綴、$3 說明。沒有這一列 → 新增 GAP；有 → 狀態升到 GAP（GAP、FAIL 不動），說明接在後面。
kernel_stage_floor(){
  local n
  n=$(awk -F'\t' -v s="$1" '$1==s{n=NR} END{print n+0}' "$ST")
  if [ "$n" = 0 ]; then status "$1" GAP "$2：$3"; return 0; fi
  awk -F'\t' -v OFS='\t' -v n="$n" -v note="$3" 'NR==n{ if ($2!="GAP" && $2!="FAIL") $2="GAP"; $3=$3 (($3!="")?"；":"") note } {print}' "$ST" > "$ST.tmp" \
    && mv "$ST.tmp" "$ST" && echo "[GAP] $1 $3"
  return 0
}
# 收尾：寫 scan/kernel-versions.json 與沒判定的核心的狀態列；多顆指定時兩個階段在這裡記 GAP（工具沒有執行）。
kernel_versions_finish(){
  local pa=(--out "$KVF") r line v note= unk=
  rm -f "$KVF"
  if [ "$KSHIP_OK" != 1 ]; then    # 判定工具沒有讀映像（或沒讀成功）：補讀一次
    r=$(timeout 3600 python3 -I "$ROOT/tools/pilot/lib/kernel_config.py" --list-kernel-versions "${KSRC[@]}" 2>&1); kernel_ship_from "$r"
  fi
  if [ "$KSHIP_OK" = 1 ]; then for v in "${KSHIP[@]+"${KSHIP[@]}"}"; do pa+=(--shipped "$v"); done; else pa+=(--shipped-unknown); fi
  for v in "${KVERS[@]+"${KVERS[@]}"}"; do pa+=(--requested "$v"); done
  for v in "${KUPS[@]+"${KUPS[@]}"}"; do pa+=(--upstream-version "$v"); done   # 平台設定的上游版本（kernel_versions.py 和 Makefile 核對）
  # 每顆出貨核心的上游版本：只認核心原始碼（環境變數 KERNEL_SOURCE_DIR，scan-flash-package.sh 的 --kernel-source）最上層 Makefile 的 X.Y.Z，
  # 由 kernel_versions.py 逐顆比對出貨版本字串；沒有原始碼 → upstream_version 是 null（不從版本字串推測）
  if [ -n "${KERNEL_SOURCE_DIR:-}" ]; then
    r=$(timeout 60 python3 -I "$ROOT/tools/pilot/lib/kernel_config.py" --source-tree-version "$(readlink -m -- "$KERNEL_SOURCE_DIR")" 2>&1)
    line=$(printf '%s\n' "$r" | grep -m1 $'^KERNEL-TREE-VERSION\t'); local ts tt
    if [ -n "$line" ]; then IFS=$'\t' read -r _ ts tt <<< "$line"; else ts=GAP; tt="kernel_config.py --source-tree-version 失敗或逾時"; fi
    if [ "$ts" = OK ]; then pa+=(--source-version "$tt"); else pa+=(--source-gap "$tt"); fi
  fi
  r=$(timeout 300 python3 -I "$ROOT/tools/pilot/lib/kernel_versions.py" "${pa[@]}" 2>&1); local rc=$?
  if [ $rc -ne 0 ]; then
    rm -f "$KVF"; status C-kernel-versions FAIL "kernel_versions.py 失敗：$(printf '%s\n' "$r" | tail -1)（映像出貨的核心有沒有判定不明）"
    kernel_stage_floor C-kernel-config "核心的 CVE 沒有依 .config 判定" "映像出貨的核心有沒有判定不明（kernel_versions.py 失敗）"
    kernel_stage_floor C-kernel-module-map "核心的 CVE 沒有對應到模組" "映像出貨的核心有沒有判定不明（kernel_versions.py 失敗）"
    return 0
  fi
  while IFS= read -r line; do
    case $line in
      KERNEL-NOT-JUDGED$'\t'*) IFS=$'\t' read -r _ v unk <<< "$line"
        status "C-kernel-not-judged-$v" GAP "核心 $v 出貨但沒有判定：$unk；要排除某顆核心必須記錄證據（例如設計文件寫明這個板子不載入它）";;
      KERNEL-VERSIONS-UNKNOWN$'\t'*) IFS=$'\t' read -r _ unk <<< "$line"
        status C-kernel-versions GAP "$unk（來源：$KLABEL）"; [ -n "$note" ] || note=$unk;;
      KERNEL-VERSIONS-NOTE$'\t'*) IFS=$'\t' read -r _ note <<< "$line";;
    esac
  done <<< "$r"
  if [ -n "$note" ]; then
    kernel_stage_floor C-kernel-config "核心的 CVE 沒有依 .config 判定" "$note"
    kernel_stage_floor C-kernel-module-map "核心的 CVE 沒有對應到模組" "$note"
  fi
  return 0
}
# 刷機包有兩顆不同的核心（C-kernel-boot，tools/pilot/lib/kernel_boot.py，scan/kernel-boot.json）：kernel/Image 與 rootfs/boot/Image 並列
# （版本字串、建置時間、設定差異）。預設不改 K1：燒錄流程預期裝 kernel/Image。環境變數 KERNEL_BOARD_OS_TXT（選用，板子 board-test 的 os.txt）
# 有 uname -v 時比對；只有板子的 uname -v 只對上 rootfs/boot/Image 時（k1_kernel rootfs），C-kernel-config 才改用該 Image（--prefer-rootfs-image），
# 核心建置紀錄除非 BUILD-INFO.txt 的 sha256 對得上，否則 GAP。需要刷機包的前綴（--kernel-build-prefix）；沒有兩顆核心時不寫這一列。
KBF=$OUT/scan/kernel-boot.json
rm -f "$KBF"
if [[ "$MODE" =~ ^(image|sbom)$ ]] && [ $SBOM_OK = 1 ] && [ ${#KSRC[@]} -gt 0 ] && [ -n "$KBUILD_PREFIX" ]; then
  kba=(--out "$KBF"); [ -n "${KERNEL_BOARD_OS_TXT:-}" ] && kba+=(--board-os-txt "$(readlink -m -- "$KERNEL_BOARD_OS_TXT")")
  [ -n "${KERNEL_BUILD_RECORD:-}" ] && kba+=(--build-record "$(readlink -m -- "$KERNEL_BUILD_RECORD")")
  r=$(timeout 3600 python3 -I "$ROOT/tools/pilot/lib/kernel_boot.py" --from "$KBUILD" --prefix "$KBUILD_PREFIX" "${kba[@]}" 2>&1)
  l=$(printf '%s\n' "$r" | grep -m1 $'^C-kernel-boot\t')
  if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"
    case $s2 in NOT_RUN) rm -f "$KBF";; *) status "$s1" "$s2" "$s3";; esac
  else rm -f "$KBF"; status C-kernel-boot FAIL "kernel_boot.py 失敗（或超過 3600 秒；來源：$KLABEL）：$(echo "$r" | tail -1)"; fi
  [ -s "$KBF" ] && grep -q '"k1_kernel": "rootfs"' "$KBF" && { KREC+=(--prefer-rootfs-image); KPREF=(--prefer-rootfs-image); }
fi
[[ "$MODE" =~ ^(image|sbom)$ ]] && [ $SBOM_OK = 1 ] && [ ${#KSRC[@]} -gt 0 ] && [ "$KNONE" != 1 ] && kernel_versions_prepare
# CNA 鏡像是沿用的舊資料（tools/mirror/kernel-cve.sh 的 KERNEL_CVE_FALLBACK_FROM：上游連不上）：結果照用，但報告要看得到
if [[ "$MODE" =~ ^(image|sbom)$ ]] && [ -n "$KERNEL_CVE_MIRROR" ] && [ -f "$KERNEL_CVE_MIRROR/SOURCE" ] \
   && grep -qx 'fallback=yes' "$KERNEL_CVE_MIRROR/SOURCE"; then
  status C-kernel-cve-mirror ATTENTION "$(sed -n 's/^fallback_note=//p' "$KERNEL_CVE_MIRROR/SOURCE" | head -1)"
fi
if [ "$KNONE" = 1 ]; then
  # 分層：這份報告的 SBOM 沒有作業系統核心，核心在另一份報告判定（--kernel-in-other-report）。核心的三個階段不適用：記 NOT_RUN，
  # 不執行 CNA 版本比對、kernel_config.py、kernel_module_map.py（否則 -os 層會對映像裡的核心跑一遍：Jetson 得 3 列假的 GAP，
  # Raspberry Pi 的 CNA 比對會成功，在 -os 報告裡產生約 2700 列合成的核心弱點）。出貨核心有沒有判定是另一份報告的事：
  # 不記 C-kernel-not-judged-*、不寫 scan/kernel-versions.json（KVACT 沒有設，kernel_versions_finish 不執行）
  for _st in C-kernel-cve-list C-kernel-config C-kernel-module-map; do
    status "$_st" NOT_RUN "不適用：這份報告的 SBOM 沒有作業系統核心，核心在 $KOTHER 報告判定"
  done
elif [ "$KVMULTI" = 1 ]; then :      # 指定 2 顆以上：一顆都不判定（kernel_versions_finish 記 GAP）
elif [[ "$MODE" =~ ^(image|sbom)$ ]] && [ $SBOM_OK = 1 ] && [ ${#KSRC[@]} -gt 0 ] && { [ -s "$GR" ] || [ -s "$OUT/dt/findings.json" ] || [ -n "${KERNEL_CVES:-}" ]; }; then
  ka=(); [ -s "$GR" ] && ka+=(--grype "$GR"); [ -s "$OUT/dt/findings.json" ] && ka+=(--findings "$OUT/dt/findings.json")
  [ -s "$OUT/scan/l4t-kernel-map.json" ] && ka+=(--kernel-map "$OUT/scan/l4t-kernel-map.json")
  [ -n "$KERNEL_CVE_MIRROR" ] && ka+=(--mirror "$KERNEL_CVE_MIRROR")
  [ ${#KVARGS[@]} -gt 0 ] && ka+=("${KVARGS[@]}")      # --kernel-version：剛好指定 1 顆時交給 kernel_config.py 與 kernel_module_map.py
  ka+=(--also-list-kernel-versions)                    # 讀映像的同一趟順便列出出貨的核心（kernel_ship_from）
  # 刷機包要整個解壓（數 GB 的 bzip2）：時間上限 3600 秒；映像 tar 與資料夾通常幾十秒
  kcl_tried=0; kskip=0
  if [ -n "${KERNEL_CVES:-}" ]; then      # 明確給的清單：和 Grype／DT 的核心 CVE 合併（kernel_config.py 的 --cves）
    kcl_tried=1
    if kernel_cve_list; then ka+=(--cves "$KCVL" --cves-origin "$KCVO"); else kskip=1; fi
  fi
  while [ $kskip = 0 ]; do
    r=$(timeout 3600 python3 -I "$ROOT/tools/pilot/lib/kernel_config.py" "${ka[@]+"${ka[@]}"}" "${KSRC[@]}" --out "$KCF" "${KREC[@]+"${KREC[@]}"}" 2>&1)
    kernel_ship_from "$r"
    l=$(printf '%s\n' "$r" | grep -m1 $'^C-kernel-config\t')
    if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"
      # NOT_RUN＝Grype、DT（與 --cves）都沒有核心元件的 CVE：廠商核心（不是套件）。以前什麼都不寫；現在找清單來源（上面的 kernel_cve_list），
      # 有清單就帶 --cves 重跑一次；沒有清單時也寫狀態列（核心存在而沒有評估，不可以靜默消失）。映像裡看不到核心時照舊不寫。
      if [ "$s2" = NOT_RUN ] && [ $kcl_tried = 0 ]; then
        kcl_tried=1; rm -f "$KCF"
        kernel_cve_list && { ka+=(--cves "$KCVL" --cves-origin "$KCVO"); continue; }
        break
      fi
      case $s2 in NOT_RUN) rm -f "$KCF";; FAIL) rm -f "$KCF"; status "$s1" "$s2" "$s3（來源：$KLABEL）";; *) status "$s1" "$s2" "$s3（來源：$KLABEL）";; esac
    else rm -f "$KCF"; status C-kernel-config FAIL "kernel_config.py 失敗（或超過 3600 秒；來源：$KLABEL）：$(echo "$r" | tail -1)"; fi
    break
  done
  # 模組對應：同樣的輸入再讀一次（刷機包也是 3600 秒上限）
  kk=(); [ -s "$KCF" ] && kk=(--kernel-config "$KCF")      # 兩個階段各讀一次 CNA 鏡像：commit 不同時模組對應記 GAP
  r=$(timeout 3600 python3 -I "$ROOT/tools/pilot/lib/kernel_module_map.py" "${ka[@]+"${ka[@]}"}" "${KSRC[@]}" "${KPREF[@]+"${KPREF[@]}"}" "${kk[@]+"${kk[@]}"}" --out "$KMM" 2>&1)
  kernel_ship_from "$r"
  l=$(printf '%s\n' "$r" | grep -m1 $'^C-kernel-module-map\t')
  if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"
    case $s2 in NOT_RUN) rm -f "$KMM";; FAIL) rm -f "$KMM"; status "$s1" "$s2" "$s3（來源：$KLABEL）";; *) status "$s1" "$s2" "$s3（來源：$KLABEL）";; esac
  else rm -f "$KMM"; status C-kernel-module-map FAIL "kernel_module_map.py 失敗（或超過 3600 秒；來源：$KLABEL）：$(echo "$r" | tail -1)"; fi
elif [ "$MODE" = sbom ] && [ $SBOM_OK = 1 ] && [ ${#KSRC[@]} -eq 0 ]; then
  # 沒有建置設定的來源：明示沒有執行（核心的 CVE 都沒有依 .config 判定），不是「沒有問題」
  status C-kernel-config NOT_RUN "沒給 --kernel-build：核心的 CVE 沒有依產品核心的 .config 判定"
  status C-kernel-module-map NOT_RUN "沒給 --kernel-build：核心的 CVE 沒有對應到模組"
fi
[ "$KVACT" = 1 ] && kernel_versions_finish

# ---- C-euvd（tools/pilot/lib/euvd.py annotate）----
# ENISA EUVD 的 EUVD 編號與「已遭利用」標記（EUVD 的 exploited＝kev/dump＝CISA KEV ∪ ENISA EU KEV；2026-11-05 實測比 DT 的 CISA ∪ eukev.json
# 多 12 個 CVE）。CVE 取 DT 的 findings（D-dt-findings 讀取完成時）與 Grype 的結果，所以放在 D-dt-findings、C-grype 之後。
# 讀 PILOT_ENV 的 EUVD_MIRROR（deploy/pilot/euvd-mirror.sh 寫入；tools/mirror/euvd.sh 的輸出）的 index.tsv（不連網），寫 scan/euvd.json。
# 沒有設定鏡像或索引不能用 → GAP，檔案沒有 cves（讀取端不可能把它當成「0 個已被利用」）；過期 → GAP 但照樣標註（說明寫出過期）；
# DT 與 Grype 都沒有可用的 CVE 清單 → NOT_RUN（不寫檔）。cra_report.py 讀它：EUVD 標已遭利用的 CVE 兩種分級方式都是 P1、KEV 欄寫
# EUVD (CISA KEV／ENISA EU KEV)、不套批次規則；檔案的 status 不是 OK，或沒有檔案但 status.tsv 有 C-euvd 這一行（FAIL、NOT_RUN）→ 風險評估 GAP。
EUVDF=$OUT/scan/euvd.json
rm -f "$EUVDF" "$EUVDF.xz"   # 同一個 --out 重跑：不留上一次的結果給 cra_report、vex_export（這次沒有執行或失敗時）
ea=(); [[ "$dtf" =~ ^(OK|GAP)$ ]] && [ -s "$OUT/dt/findings.json" ] && ea+=(--cves "$OUT/dt/findings.json")
[ -s "$GR" ] && ea+=(--cves "$GR")
[ -s "$NVB" ] && ea+=(--cves "$NVB")   # NVIDIA 公告的 CVE（不在 DT／Grype 的結果裡）：KEV／EUVD 已遭利用的要進 P1
[ -s "$OUT/scan/kernel-cve-list.txt" ] && ea+=(--cves "$OUT/scan/kernel-cve-list.txt")   # 廠商核心的 CVE 清單（kernel_cve_list）：已遭利用的核心 CVE 要進 P1
if [ ${#ea[@]} = 0 ]; then
  status C-euvd NOT_RUN "沒有 CVE 清單（D-dt-findings、C-grype 都沒有可用的結果）：沒有標註 EUVD 的已遭利用標記"
else
  r=$(timeout 300 python3 -I "$ROOT/tools/pilot/lib/euvd.py" annotate --index "$EUVD_MIRROR" "${ea[@]}" --out "$EUVDF" 2>&1)
  l=$(printf '%s\n' "$r" | grep -m1 $'^C-euvd\t')
  if [ -n "$l" ]; then IFS=$'\t' read -r s1 s2 s3 <<< "$l"; [ "$s2" = FAIL ] && rm -f "$EUVDF"; status "$s1" "$s2" "$s3"
  else rm -f "$EUVDF"; status C-euvd FAIL "euvd.py 失敗（或超過 300 秒）：$(echo "$r" | tail -1)"; fi
fi
# ---- C-euvd 結束 ----

# ---------- E. ScanCode.io load_sbom → DejaCode 匯入（import_from_scan；逐套件掃描時 load_sboms）→ 讀回授權 ----------
# 出處：
#   ScanCode.io v38.1.0 docs/rest-api.rst：POST /api/projects/（name、pipeline、execute_now、upload_file；Authorization: Token）、
#     GET /api/projects/<uuid>/（含 runs，Run.Status：not_started/queued/running/success/failure/stopped/stale，scanpipe/models.py）、
#     GET /api/projects/<uuid>/results/（ScanCode 格式 JSON）。load_sbom 管線（scanpipe/pipelines/load_sbom.py）以檔名
#     *bom.json／*.cdx.json 辨識 CycloneDX（scanpipe/pipes/resolve.py）。
#   GET /api/runs/<uuid>/（scancodeio/urls.py api_router.register("runs", RunViewSet)；RunSerializer 含 task_exitcode、task_output、log）、
#     GET /api/projects/<uuid>/messages/?severity=error（ProjectViewSet.messages、ProjectMessageFilterSet）：load_sbom 失敗時存檔並摘要 traceback。
#   上傳前轉換：tools/pilot/lib/scio_prep.py（移除 type=file 元件與超過 PackageURLMixin 欄位上限的元件；原因與出處見該檔）。
#   DejaCode v6.0.1 product_portfolio/api.py：POST /api/v2/products/、POST /api/v2/products/<uuid>/import_from_scan/
#     （upload_file、create_codebase_resources、stop_on_error，同 license.sh 與官方教學；同步請求，所以分批：lib/scio_chunks.py 的說明，
#     每批 DJ_IMPORT_CHUNK 個套件，預設 1000）、GET /api/v2/products/?name=&version=（ProductFilterSet）；
#     回應 absolute_url 是產品頁。讀回授權用 tools/e2e/djread.py（無授權 → no_license；授權沒有 usage policy → not_assessed）。
#   限速：DejaCode 預設 throttle（dejacode/settings.py DEFAULT_THROTTLE_RATES），依 Retry-After 重試（同 license.sh 的 djapi）。
djapi(){ local m=$1 p=$2 out=$3; shift 3; local i c ra; for i in 1 2 3 4 5 6; do
  c=$(curl -sS -m 1800 -D "$WORK/dj-h.txt" -H "Expect:" -X "$m" -H @"$DJ_HDR" -o "$out" -w '%{http_code}' "$@" "$DEJACODE_URL$p" 2>>"$WORK/curl-dj.err")
  [ "$c" != 429 ] && break
  ra=$(grep -i '^retry-after:' "$WORK/dj-h.txt" | tr -dc 0-9); sleep $(( ${ra:-2} > 60 ? 60 : ${ra:-2} )); done; echo "${c:-000}"; }
scio(){ local m=$1 p=$2 out=$3 c; shift 3; c=$(curl -sS -m 300 -X "$m" -H @"$SCIO_HDR" -o "$out" -w '%{http_code}' "$@" "$SCANCODEIO_URL$p" 2>>"$WORK/curl-scio.err"); echo "${c:-000}"; }
# 等 ScanCode.io 專案的最後一個 run 結束；$1 專案 uuid、$2 秒數上限、$3 run 摘要輸出。結果放在 SCIO_RS（逾時時附註）
scio_wait(){ local pu=$1 lim=$2 t0; t0=$(date +%s)
  while :; do scio GET "/api/projects/$pu/" "$WORK/scio-p.json" > /dev/null
    SCIO_RS=$(python3 -I -c 'import json,sys
r=(json.load(open(sys.argv[1])).get("runs") or [{}])[-1];print(r.get("status",""))' "$WORK/scio-p.json" 2>/dev/null)
    case $SCIO_RS in success|failure|stopped|stale) break;; esac
    [ $(( $(date +%s) - t0 )) -ge "$lim" ] && { SCIO_RS="$SCIO_RS（等待 ${lim} 秒逾時）"; break; }; sleep 5; done
  python3 -I -c 'import json,sys
d=json.load(open(sys.argv[1]));r=(d.get("runs") or [{}])[-1]
json.dump({"project":d.get("name"),"uuid":d.get("uuid"),"run_status":r.get("status"),"pipeline":r.get("pipeline_name"),"scancodeio_version":r.get("scancodeio_version"),
"run_uuid":r.get("uuid"),"task_exitcode":r.get("task_exitcode"),"execution_time":r.get("execution_time"),"log_tail":(r.get("log") or "")[-1500:],
"task_output_tail":(r.get("task_output") or "")[-3000:]},open(sys.argv[2],"w"),ensure_ascii=False,indent=1)' "$WORK/scio-p.json" "$3" 2>/dev/null; }
# run 失敗時：完整的 run（GET /api/runs/<uuid>/，RunSerializer 含 task_output＝traceback）與 error 等級的專案訊息；摘要放在 SCIO_DIAG
scio_diag(){ local pu=$1 dir=$2 pre=$3 ru; SCIO_DIAG=
  ru=$(jget "$dir/$pre-run.json" run_uuid)
  [ -n "$ru" ] && scio GET "/api/runs/$ru/" "$dir/$pre-run-detail.json" > /dev/null
  scio GET "/api/projects/$pu/messages/?severity=error" "$dir/$pre-messages.json" > /dev/null
  if [ -s "$dir/$pre-run-detail.json" ]; then SCIO_DIAG=$(python3 -I "$ROOT/tools/pilot/lib/scio_diag.py" "$dir/$pre-run-detail.json" "$dir/$pre-messages.json")
  else SCIO_DIAG="讀不到 /api/runs/${ru:-?}/（run 詳細資料）"; fi; }
# ---- 逐套件掃描（E-package-scan*）：DejaCode 下載每個套件交給 ScanCode.io scan_single_package，掃出授權與版權 ----
# 出處（DejaCode v6.0.1）：product_portfolio/api.py ProductViewSet.load_sboms（LoadSBOMsFormSerializer：input_file、infer_download_urls、
#   update_existing_packages、scan_all_packages、create_dependencies）→ ScanCode.io load_sbom → 匯入（importers.py ImportPackageFromScanCodeIO：
#   infer_download_urls 時以 purl 推下載網址；update_existing 時只補空白欄位）→ scan_all_packages 時 Product.scan_all_packages_task
#   （只送 http(s) 下載網址；dje/tasks.py scancodeio_submit_scan 先檢查網址可達，已有掃描的直接沿用）。
#   掃描完成 → webhook → Package.update_from_scan（只補空白、override_unknown）＋產品套件 unknown → 套件授權。
#   這個 REST 動作是 UI「Scan all packages」以外唯一的觸發方式（scan_all_packages_view 只有網頁表單）。
#   逐套件掃描時產品套件只由 load_sboms 匯入（不先 import_from_scan；原因寫在下面匯入的地方）。
# 第二次觸發：webhook 逾時 10 秒，dj-web 忙時會漏；第二次 scan_all 時已有掃描的套件改走 update_package_from_existing_scan_data 補上
#   （只補套件；產品套件由 pkgscan.py sync-unknown 依 ProductPackage.update_license_unknown 的同一條規則補）。詳見 lib/pkgscan.py。
# 下載網址連的是套件來源（npm、Maven Central、PyPI…）；離線部署要讓 DejaCode 與 ScanCode.io 連內部套件代理。
scio_cancel(){ [ -s "$2" ] || return 0; SCANCODEIO_URL=$SCANCODEIO_URL SCANCODEIO_API_KEY=$SCANCODEIO_API_KEY python3 -I "$ROOT/tools/pilot/lib/scio_cancel.py" "$@"; }
pkg(){ DEJACODE_URL=$DEJACODE_URL DEJACODE_API_TOKEN=$DEJACODE_API_KEY DJ_PRODUCT=$PID python3 -I "$ROOT/tools/pilot/lib/pkgscan.py" "$@"; }
scan_trigger(){  # $1＝輸出檔名前綴；回傳 0＝匯入結束（狀態寫在 SCAN_ST、SCAN_D）
  local r c
  SCAN_STAGE=unsent   # unsent＝沒有送出、done＝匯入已結束、wait＝送出了但不知道結束沒有（逾時或讀狀態失敗）
  r=$(pkg imports "$O/$1-imports-before.json"); [ "${r%%$'\t'*}" = OK ] || { SCAN_ST=FAIL; SCAN_D="讀匯入清單失敗：${r#*$'\t'}"; return 1; }
  c=$(djapi POST "/api/v2/products/$PID/load_sboms/" "$O/$1-load-sboms.json" -F "input_file=@$SCIO_UP;filename=bom.cdx.json" \
      -F infer_download_urls=true -F update_existing_packages=true -F scan_all_packages=true -F create_dependencies=false)
  [ "$c" = 200 ] || { SCAN_ST=FAIL; SCAN_D="load_sboms http=$c $(head -c 200 "$O/$1-load-sboms.json" 2>/dev/null | tr '\n' ' ')"; return 1; }
  SCAN_STAGE=wait; r=$(pkg wait-import "$O/$1-imports-before.json" "${SCIO_WAIT_SECONDS:-1800}" "$O/$1-import.json")
  [ "$(jget "$O/$1-import.json" timed_out)" = False ] && SCAN_STAGE=done
  SCAN_ST=${r%%$'\t'*}; SCAN_D=${r#*$'\t'}; [ "$SCAN_ST" = OK ] || [ "$SCAN_ST" = ATTENTION ]; }
# 第一次觸發之後：等掃描、失敗原因、第二次觸發
# 逾時時取消這個產品留在 ScanCode.io 佇列裡的工作（lib/scio_cancel.py），不讓它們卡住第二次觸發與下一次 sca-scan。第二次觸發
# 也是 scan_all：取消時刪掉的專案會被重送（DejaCode 只沿用還在的專案），所以第二次觸發之後再取消一次。
package_scan_wait(){
  local r fr cx sst sd
  r=$(pkg wait-scans "${PACKAGE_SCAN_WAIT_SECONDS:-3600}" "$O/package-scan-progress.txt" "$O/package-scans.json")
  cx=$(scio_cancel "$O/package-scan-cancel.json" "$O/package-scans.json")
  fr=; case $r in *"failure "[1-9]*) fr=$(SCANCODEIO_URL=$SCANCODEIO_URL SCANCODEIO_API_KEY=$SCANCODEIO_API_KEY python3 -I "$ROOT/tools/pilot/lib/scio_failures.py" \
    "$O/package-scans.json" "$O/package-scan-failures.json");; esac
  status E-package-scans "${r%%$'\t'*}" "${r#*$'\t'}${fr:+；失敗原因（dejacode/package-scan-failures.json）：$fr}${cx:+；$cx（dejacode/package-scan-cancel.json）}"
  if scan_trigger update; then sst=$SCAN_ST sd="第二次觸發（補上 webhook 沒送到的掃描結果）：$SCAN_D"
  else sst=$SCAN_ST sd="第二次觸發失敗（webhook 沒送到的套件可能沒有更新）：$SCAN_D"
    cx=$(scio_cancel "$O/update-cancel.json" "$O/update-import.json"); sd="$sd${cx:+；匯入：$cx}"; fi
  # 第二次匯入後重讀掃描清單（狀態不變，套件欄位可能已更新）；重送的掃描再取消一次（清單保留取消前的狀態）
  r=$(pkg wait-scans 0 "$O/package-scan-progress.txt" "$O/package-scans.json")
  cx=$(scio_cancel "$O/update-scan-cancel.json" "$O/package-scans.json")
  status E-package-scan-update "$sst" "$sd${cx:+；重送的掃描：$cx}"; }
DJ_SKIP=
[ $NOUP = 1 ] && DJ_SKIP="--no-upload"
[ -z "$DJ_SKIP" ] && [ $LICENSE = 0 ] && DJ_SKIP="--no-license"
[ -z "$DJ_SKIP" ] && [ $HAVE_ENV != 1 ] && DJ_SKIP="沒有 $PILOT_ENV"
[ -z "$DJ_SKIP" ] && { [ -n "$DEJACODE_URL" ] && [ -n "$DEJACODE_API_KEY" ] && [ -n "$SCANCODEIO_URL" ] || DJ_SKIP="pilot.env 缺 DEJACODE_URL、DEJACODE_API_KEY 或 SCANCODEIO_URL"; }
# dumpling 沒有帶進授權匯入（DejaCode／ScanCode.io）用的輔助程式（docs/PROVENANCE.md「沒帶進來的相依」）：pilot.env 設了網址也只能記 NOT_RUN，
# 不能因為找不到檔案而 FAIL，也不能假裝做過。缺的檔名寫進原因。
missing_libs(){ local f m=; for f in "$@"; do [ -f "$ROOT/$f" ] || m+="${f##*/} "; done; echo "${m% }"; }
if [ -z "$DJ_SKIP" ]; then
  ml=$(missing_libs tools/pilot/lib/{scio_prep,scio_diag,scio_cancel,scio_chunks,scio_failures,pkgscan,djsbom,licverdict,notice}.py tools/e2e/djread.py)
  [ "$MODE" = image ] && [ "${OS_COPYRIGHTS:-0}" = 1 ] && ml+=" $(missing_libs tools/pilot/lib/oscopyright.py)"
  ml=$(echo $ml)   # 去掉多餘空白
  [ -n "$ml" ] && DJ_SKIP="授權匯入（DejaCode／ScanCode.io）的輔助程式沒有帶進 dumpling（缺：$ml），pilot.env 的網址沒有使用"
fi
