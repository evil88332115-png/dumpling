              "$EVF" "$O/NOTICE.txt" "$O/notice-summary.json")
          status E-notice "${r%%$'\t'*}" "${r#*$'\t'}（dejacode/NOTICE.txt：工具產生的草稿，發布前要人工確認）"
        else status E-dejacode-import ATTENTION "匯入 http=200 但讀回失敗：$msg"; status E-dejacode-licenses FAIL "$(echo "$dr" | tail -1)"
          [ $OSCP = 1 ] && status E-os-license-sync NOT_RUN "讀回失敗"
          for s in E-license-sync E-copyrights E-notice; do status "$s" NOT_RUN "讀回失敗"; done; fi
      fi
    fi
  else status E-dejacode-import NOT_RUN "ScanCode.io 沒有可匯入的套件"; for s in "${E_PKG_STAGES[@]}" E-dejacode-licenses E-notice; do status "$s" NOT_RUN "沒有匯入"; done
    [ $OSCP = 1 ] && status E-os-license-sync NOT_RUN "沒有匯入"; fi
fi

# ---------- E2. 專案本身或映像的檔案層級授權與版權（ScanCode.io） ----------
# 出處（ScanCode.io v38.1.0）：scanpipe/pipelines/scan_codebase.py（解壓上傳的封存 → 套件 → scan_for_files：授權、版權、email、url；
#   不再掃套件裡的檔案）、analyze_docker.py（docker save 的映像 tar：解開各層 → 系統套件 → 不屬於系統套件的檔案再掃授權與版權）。
#   GET /api/projects/<uuid>/results/ 的 files[]（tools/pilot/lib/filescan.py）。依賴套件的檔案在 E-package-scans 由 DejaCode 逐一掃。
#   已知：lazydocker、petclinic 的 scan_codebase 在 packagedcode 出錯（docs/status.md；e2e 第 18 輪），失敗時照實記 FAIL 與 traceback 摘要。
FS_SKIP= FIN= FPIPE=
[ $NOUP = 1 ] && FS_SKIP="--no-upload"
[ -z "$FS_SKIP" ] && [ $LICENSE = 0 ] && FS_SKIP="--no-license"
[ -z "$FS_SKIP" ] && [ $FILESCAN = 0 ] && FS_SKIP="--no-files-scan"
[ -z "$FS_SKIP" ] && [ $HAVE_ENV != 1 ] && FS_SKIP="沒有 $PILOT_ENV"
[ -z "$FS_SKIP" ] && [ -z "$SCANCODEIO_URL" ] && FS_SKIP="pilot.env 缺 SCANCODEIO_URL"
if [ -z "$FS_SKIP" ]; then
  ml=$(missing_libs tools/pilot/lib/{filescan,scio_diag}.py)
  [ -n "$ml" ] && FS_SKIP="檔案層級授權掃描（ScanCode.io）的輔助程式沒有帶進 dumpling（缺：$ml），pilot.env 的網址沒有使用"
fi
case $MODE in sbom) FS_SKIP=${FS_SKIP:-"--sbom：沒有檔案可掃（只有依賴清單）"};; image) FIN=$IMG_TAR; FPIPE=analyze_docker_image;; *) FIN=$SRC_TAR; FPIPE=scan_codebase;; esac
[ -z "$FS_SKIP" ] && { [ -n "$FIN" ] && [ -s "$FIN" ] || FS_SKIP="沒有可上傳的檔案（見 A-source）"; }
if [ -n "$FS_SKIP" ]; then status E-files-scan NOT_RUN "$FS_SKIP"
else
  F=$OUT/scancode; mkdir -p "$F"
  c=$(scio POST /api/projects/ "$F/project.json" -F "name=sca-scan-files-$NAME-$TS" -F "pipeline=$FPIPE" -F execute_now=true -F "upload_file=@$FIN")
  fu=$(jget "$F/project.json" uuid)
  if [ "$c" != 201 ] || [ -z "$fu" ]; then status E-files-scan FAIL "建專案 http=$c（$(head -c 200 "$F/project.json" 2>/dev/null | tr '\n' ' ')）"
  else
    META[scancodeio_files_project_uuid]=$fu
    scio_wait "$fu" "${FILES_SCAN_WAIT_SECONDS:-3600}" "$F/files-run.json"
    if [ "$SCIO_RS" != success ]; then scio_diag "$fu" "$F" files
      status E-files-scan FAIL "$FPIPE 專案 $fu run=${SCIO_RS:-無}；$SCIO_DIAG（完整 task_output：scancode/files-run-detail.json）"
    elif [ "$(scio GET "/api/projects/$fu/results/" "$WORK/files-results.json")" != 200 ]; then status E-files-scan FAIL "讀結果失敗（專案 $fu）"
    else r=$(python3 -I "$ROOT/tools/pilot/lib/filescan.py" "$WORK/files-results.json" "$FPIPE" "$F/files-summary.json")
      status E-files-scan "${r%%$'\t'*}" "${r#*$'\t'}；ScanCode.io 專案 $fu"; fi
  fi
fi

# ---------- F. 收尾：meta.json、秘密掃描、報告 ----------
META[finished]=$(now)
args=(); for k in "${!META[@]}"; do args+=("$k=${META[$k]}"); done
python3 -I - "$OUT/meta.json" "${args[@]}" <<'PY'
import json,sys
m={}
for a in sys.argv[2:]:
    k,_,v=a.partition("="); m[k]=v
tools={k[5:]:m.pop(k) for k in list(m) if k.startswith("tool_")}
m["tools"]=tools
m["network"]={"sbom_resolution_online":m.get("network_resolve")=="1",
              "data_sources_online":True,
              "note":"試行版使用線上資料源（Grype DB、DT 的 NVD／OSV／EPSS／KEV、govulncheck 的 vuln.go.dev），不是離線鏡像"}
json.dump(m,open(sys.argv[1],"w"),ensure_ascii=False,indent=1,sort_keys=True)
PY
secret_scan(){  # 輸出資料夾中出現秘密的檔案直接刪除（不是遮蔽），並記 FAIL。秘密由 leakscan.py 從檔案讀，不出現在指令列
  local f hit=(); mapfile -t hit < <(python3 -I "$ROOT/tools/pilot/lib/leakscan.py" "$SECRETS" "$OUT")
  if [ ${#hit[@]} -gt 0 ]; then rm -f -- "${hit[@]}"; status "$1" FAIL "輸出中出現金鑰，已刪除 ${#hit[@]} 個檔案：$(for f in "${hit[@]}"; do printf '%s ' "${f#$OUT/}"; done)"
  else status "$1" OK "輸出中沒有 pilot.env 的金鑰"; fi; }
secret_scan F-secret-scan
if python3 -I "$ROOT/tools/pilot/report.py" --out "$OUT" > "$WORK/report.txt" 2>&1; then echo "報告：$OUT/report.html"
else status F-report FAIL "$(tail -1 "$WORK/report.txt")"; python3 -I "$ROOT/tools/pilot/report.py" --out "$OUT" > /dev/null 2>&1; fi
if [ -n "$(python3 -I "$ROOT/tools/pilot/lib/leakscan.py" "$SECRETS" "$OUT/report.html" "$OUT/report.json")" ]; then
  rm -f "$OUT/report.html" "$OUT/report.json"; status F-report FAIL "報告中出現金鑰，已刪除報告"; fi
# 退出碼：有 FAIL → 1；有其他非 OK → 2；全 OK → 0
x=$(awk -F'\t' 'NR>1{ if($2=="FAIL") f=1; else if($2!="OK") n=1 } END{ print f?1:(n?2:0) }' "$ST")
echo "狀態：$ST（退出碼 $x；0 才表示每個階段都完成，仍不代表安全）"
exit "$x"
