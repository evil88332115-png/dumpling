#!/usr/bin/env bash
# sca-scan：試行版的掃描入口。產生 SBOM、弱點比對、上傳 DT、匯入 DejaCode，最後產生 HTML 報告。
#
# 用法：
#   sca-scan --git <網址> --ref <完整 commit SHA> [--name N]
#   sca-scan --dir <路徑> [--name N]
#   sca-scan --image <映像，建議 名稱@sha256:…> [--name N]
#     （本機的映像 ID sha256:<64 個十六進位字元>，例如 docker import 的結果：不 pull，以映像 ID 固定）
#   sca-scan --sbom <CycloneDX JSON 檔> [--name N]（已經有 SBOM：不跑產生器，直接比對、上傳）
#   共用：--out <資料夾>（預設 ./sca-results/<name>-<UTC 時間>，必須不存在或是空的）
#         --no-upload（不上傳 DT、不匯入 DejaCode；那些階段記 NOT_RUN）
#         --allow-network-resolve（原始碼：cdxgen 與 govulncheck 的依賴解析可以連網；報告標「連網解析」）
#         --no-package-scan（不讓 DejaCode 逐套件掃描授權與版權；那些階段記 NOT_RUN）
#         --no-files-scan（不用 ScanCode.io 掃專案本身或映像的檔案層級授權與版權；E-files-scan 記 NOT_RUN）
#         --no-license（只做漏洞：不連 ScanCode.io／DejaCode，E 段全部記 NOT_RUN；大型映像省掉授權那段的時間）
#         --version <字串>（DT 專案版本與 meta 的 version，取代預設的 commit／內容雜湊／映像 ID；原本的值另記 content_version。
#           只接受英數字開頭、英數字與「空白 . _ + ~ ( ) -」，最多 100 字元，例如 "V1.0.2_a (rootfs_no_gui)"）
#         --kernel-build <路徑> [--kernel-build-prefix <前綴>]（只用於 --image、--sbom：核心建置設定的來源，給 C-kernel-config；
#           rootfs tar、rootfs 資料夾，或刷機包 tbz2 加上 rootfs 在裡面的路徑。--image 沒給時用 docker save 的映像 tar）
#         --kernel-version <版本>（可重複；環境變數 SCA_KERNEL_VERSIONS 以空白或逗號分隔，兩者都給時以命令列為準。--image、--sbom：要判定的核心
#           （映像的 /usr/lib/modules/<版本>/），原樣交給 C-kernel-config、C-kernel-module-map、核心 CVE 清單；只接受英數字開頭、英數字與「. _ + ~ -」。
#           映像出貨的核心沒被指定就不判定：每一顆記一列 C-kernel-not-judged-<版本>（GAP），C-kernel-config 與 C-kernel-module-map 至少 GAP，
#           並寫 scan/kernel-versions.json（shipped、requested、judged、not_judged）。指定 2 顆以上時一顆都不判定（多顆逐一判定還沒實作）；
#           只有 1 顆核心而且沒指定時照舊判定它）
#         --kernel-upstream-version <核心版本>=<X.Y.Z>（可重複；--image、--sbom：平台設定給的上游版本，交給 kernel_versions.py --upstream-version，
#           和核心原始碼 Makefile 核對：一致才填 upstream_version，不一致不採用；格式不對 exit 64）
#         --kernel-in-other-report <報告名稱>（環境變數 SCA_KERNEL_IN_OTHER_REPORT；--image、--sbom。分層：這份報告的 SBOM 是某一層（例如只有使用者空間的 -os），
#           作業系統核心在另一份報告（例如 <專案>-bsp）判定。給了而且 kernelcheck 判定這份 SBOM 沒有作業系統核心（C-kernel-coverage 的 NOT_RUN）時：
#           C-kernel-cve-list、C-kernel-config、C-kernel-module-map 各記一列 NOT_RUN「不適用」，不執行 CNA 版本比對、kernel_config.py、kernel_module_map.py，
#           不記 C-kernel-not-judged-*，也不寫 scan/kernel-versions.json。SBOM 有核心時照舊。沒給時行為不變：單一 SBOM 的廠商核心（不是套件）仍走 CNA 版本比對，
#           所以不能只由「SBOM 沒有核心」推定。名稱只接受 ^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$，否則 exit 64）
#         --kernel-not-distro <理由>（環境變數 SCA_KERNEL_NOT_DISTRO；--image、--sbom。平台負責人宣告：這個產品的核心不是發行版（Debian／Ubuntu）的核心，
#           版本字串看不出來時用，例如部分 Radxa 核心。SBOM 有核心時 C-kernel-coverage 是 GAP（發行版資料的比對不可靠，可能漏報），理由寫進說明與
#           scan/kernel-coverage.json 的 off_series。不是空的、沒有控制字元、最多 300 位元組，否則 exit 64。其他不在發行版核心序列上的自動判斷見 lib/kernelcheck.py）
#   環境變數 KERNEL_BUILD_RECORD（選用；只用於 --image、--sbom）：這個出貨版本的核心建置紀錄（make 之後的建置資料夾，或它的
#     .tar／.tar.gz／.tar.xz；保留 .config、每個 .*.cmd、modules.order、modules.builtin、System.map、include/config/kernel.release、
#     include/generated/（utsversion.h、compile.h：和燒錄的 Image 的版本字串核對，證明是出貨的那一次建置）），
#     給 C-kernel-config 的 --build-record：直接以每個物件的 source_／deps_ 判斷修補的檔案有沒有編。和這次判定用的 .config、
#     核心版本、映像的模組清單對不上或不完整 → 不採用（kernel.build_record 記 GAP 與原因，照舊依 Makefile 判定）。
#     出貨映像有模組（/lib/modules/<版本>/kernel/ 底下的 .ko）不在紀錄的 modules.order 時不整份拒收：紀錄照用，這些模組的檔案不判
#     not_affected（樹內的 unknown；找不到來源的標 GAP，kernel.build_record.image_modules_not_in_record）。
#   環境變數 KERNEL_OOT_BUILD_RECORDS（選用；只用於 --image、--sbom，需要 KERNEL_BUILD_RECORD）：樹外模組（例如 nvidia-oot、nvgpu）的建置資料夾，
#     用冒號分隔多個；讀裡面的 .*.o.cmd／.*.ko.cmd，判斷核心標頭檔有沒有被已編的樹外模組用到。映像每個樹外 .ko 都有完整的紀錄才採用，
#     否則標頭檔照舊因為樹外模組而 unknown（kernel.build_record.out_of_tree_records 記原因）。給 C-kernel-config 的 --oot-build-record。
#   環境變數 KERNEL_STABLE_GIT（選用；只用於 --image、--sbom）：linux-stable 的本機 clone（唯讀，不 fetch）：沒有 CNA 紀錄的 CVE 從 References 的
#     上游 commit 查改了哪些檔案；有 CNA 紀錄的 CVE 把產品分支 backport 實際改的程式檔併進 programFiles（聯集）。給 C-kernel-config 的 --stable-git。
#   環境變數 KERNEL_SOURCE_DIR（選用；只用於 --image、--sbom）：核心原始碼樹（資料夾，唯讀）當 Makefile／Kbuild 的來源——映像／刷機包的
#     linux-headers 不完整（例如廠商核心不是套件安裝的）時。.config、IKCONFIG 核對、模組與 Image 照舊來自 --kernel-build；
#     樹有 .config 時和判定用的設定核對，不同記出來（ATTENTION）；主.次版本不同 → GAP。不執行樹裡的任何東西，符號連結不跟隨。
#     給 C-kernel-config 與 C-kernel-module-map 的 --source-tree。
#   環境變數 KERNEL_CVES（選用）：明確給的核心 CVE 清單（檔案，每行一個 CVE；Grype、DT 都沒有核心 CVE 時用，或兩者都沒執行時）。
#     沒給時，Grype、DT 都沒有核心元件的 CVE（廠商核心不是套件，例如 SoC 廠商的 BSP 核心）而且有 KERNEL_CVE_MIRROR：依產品核心版本
#     （/lib/modules/<版本>，沒有時 Image 的版本字串）用 lib/kernel_cna_version.py 從 CNA 鏡像產生清單（scan/kernel-cve-list.txt、.json），
#     經 --cves 給 C-kernel-config 與 C-kernel-module-map。狀態列 C-kernel-cve-list 記清單的來源（不是 Grype／DT）；版本取不到或被拒絕 → GAP，不猜。
#     Grype 或 DT 已有核心 CVE 的產品不受影響（先照舊執行，只有 NOT_RUN 時才走這一條）。
#
# 規則（專案規則、試行版範圍）：
# - 每個階段寫一列到 <out>/status.tsv（stage、status、detail），狀態只用 OK／ATTENTION／GAP／NOT_ASSESSED／FAIL／NOT_RUN，
#   不合併成一個「成功」。OK 只表示該階段完成且輸出可用，不代表安全。
# - 退出碼：有 FAIL → 1；沒有 FAIL 但有任何非 OK（GAP／NOT_ASSESSED／NOT_RUN／ATTENTION）→ 2；全部 OK → 0。參數錯誤 → 64。
# - 原始碼只用 cdxgen（在 bwrap 沙箱、預設無網路）；映像只用 Syft（同一產物只用一個產生器）。Grype 比對 SBOM（sbom:）；Go 專案加 govulncheck。
#   映像與 --sbom 另檢查作業系統核心有沒有做比對（C-kernel-coverage，SBOM 有核心時才寫）：有核心但 0 筆比對 → GAP，不可當作核心沒有弱點。
#   Jetson Linux（SBOM 有 nvidia-l4t-* 套件）另用人工對照表比對 NVIDIA 安全公告（C-nvidia-bulletins，scan/nvidia-bulletins.json）。
#   Debian／Ubuntu 套件上只經 NVD 等非發行版資料比對到的 DT 發現，以發行版的 OSV 紀錄再判（D-distro-recheck，scan/distro-recheck.json；
#   原始 findings 不改，cra_report.py 把「發行版已修補」的列移出 P1–P3）。沒有 CVE 別名的 USN 從同一個鏡像查它列的 CVE
#   （D-usn-cves，scan/usn-cves.json；cra_report.py 把 USN 併進同一個元件上那個 CVE 的列）。Ubuntu 套件（含 Canonical 核心）上的 CVE
#   從同一個鏡像讀 Ubuntu priority（D-ubuntu-priority，scan/ubuntu-priority.json；cra_report.py 分級的嚴重度依供應商評級優先）。
#   核心的 CVE 以產品核心的 .config 與 Makefile 判斷修補的程式有沒有編進核心（C-kernel-config，scan/kernel-config.json；
#   只列出，原始 findings 不改；tools/cra/vex_export.py 讀這個檔，把 not_affected 寫成 VEX 的 code_not_present）。
#   同樣的輸入另依 Kbuild 規則把修補動到的檔案對應到 builtin／模組（C-kernel-module-map，scan/kernel-module-map.json；只對應，給 K2）。
# - sudo 執行時（sudo 會把 PATH 重設成 secure_path）找不到 grype 或 syft，而且 /opt/sca-tools/bin 存在（SCA_TOOLS_DIR 可改；
#   deploy/gitlab-runner/install.sh 裝工具的位置）：把 /opt/sca-tools 的 bin、node/bin、go/bin 加到 PATH 前面（A-tools 的說明會寫出來）。
#   root 執行時只接受 root 擁有、群組與其他人不可寫的資料夾。
# - --sbom：使用者提供的 SBOM（CycloneDX JSON）原樣當作 sbom/sbom.cdx.json，不執行任何產生器；依賴樹是否完整由提供者決定，
#   sbomgate 一律 --tree unknown（最多 PARTIAL，不宣稱完整）。版本、DT／DejaCode 的版本用檔案的 sha256。
# - 不可信的程式（cdxgen 會執行套件管理器、govulncheck 會載入專案）只在沙箱內執行（tools/e2e/sandbox.sh）：
#   不論是否連網，家目錄（getent passwd）與 /home/runner/runners 一律以 tmpfs 遮蔽，PILOT_ENV 與本程式的秘密資料夾另外遮蔽，
#   只唯讀掛回工具、暫存區與 Grype DB。
# - --allow-network-resolve 只能用於可信的專案：沙箱有網路時，專案的建置腳本可以連到外部，也可以連到主機 127.0.0.1 上
#   沒有驗證的服務（例如 Ollama 11434 埠）；bwrap 無法依目的地過濾。
# - API key 不寫進任何輸出：HTTP 標頭放在權限 600 的暫存檔（curl -H @檔案），不出現在指令列；結束前掃描輸出資料夾。
#
# 與部署的介面：環境變數 PILOT_ENV（預設 <repo>/deploy/pilot/state/pilot.env），KEY=VALUE 格式，只讀下列鍵（不 source，不執行內容）：
#   PILOT_NVD_MIRROR、NVD_MIRROR_MODIFIED（NVD 鏡像模式與鏡像日期；不是秘密，給 dtsources.py 判斷新鮮度）、
#   NVIDIA_BULLETINS_MIRROR（NVIDIA 安全公告鏡像的資料夾，tools/mirror/nvidia-bulletins.sh 的輸出；不是秘密，給 C-nvidia-bulletins）、
#   OSV_DISTRO_MIRROR（Ubuntu／Debian 的 OSV 鏡像資料夾，tools/mirror/osv-distro.sh 的輸出；不是秘密，給 D-distro-recheck、D-usn-cves、D-ubuntu-priority）、
#   KERNEL_CVE_MIRROR（Linux 核心 CNA 的 CVE 紀錄鏡像，tools/mirror/kernel-cve.sh 的輸出；不是秘密，給 C-kernel-config）、
#   EUVD_MIRROR（ENISA EUVD 鏡像資料夾，tools/mirror/euvd.sh 的輸出；不是秘密，給 C-euvd，以及 D-dt-kev-sources 判斷 DT 讀的 EU KEV 檔是否最新）、
#   UBUNTU_CVE_STATUS_MIRROR（Ubuntu CVE Tracker 狀態鏡像，tools/mirror/ubuntu-cve-status.sh 的輸出；不是秘密，給 D-ubuntu-status）、
#   DT_URL（DT API 基底，可帶或不帶結尾的 /api）、DT_FRONTEND_URL、DT_API_KEY、DEJACODE_URL、DEJACODE_API_KEY、
#   SCANCODEIO_URL、SCANCODEIO_API_KEY（可空）。檔案不存在時 DT／DejaCode 階段記 NOT_RUN，其餘照跑。
# DT 金鑰需要的權限（DT 5.2.0 原始碼的 @PermissionRequired）：
#   VIEW_PORTFOLIO（專案查詢）、PORTFOLIO_MANAGEMENT 或 PORTFOLIO_MANAGEMENT_CREATE（建立專案）、BOM_UPLOAD、VIEW_VULNERABILITY（finding）；
#   建議另給 SYSTEM_CONFIGURATION_READ：才能讀 /api/v2/internal/workflow-runs，把「BOM 處理」與「弱點分析」分開確認。
#   沒有時退回 /api/v1/bom/token/{token} 加專案的 lastBomImport／lastVulnerabilityAnalysis 時間（見 D 段）。
#   SYSTEM_CONFIGURATION_READ 也用來讀弱點資料源的 mirror 狀態（D-dt-data-sources）；沒有這個權限時資料源狀態未知 → GAP。
#
# 共用（不重寫邏輯）：tools/e2e/sandbox.sh（sbx、sandbox_probe）、tools/pilot/lib/common.sh（由 real-projects.sh 搬出）、
#   tools/sbomgate/sbomgate.py（規則 11–14）、tools/e2e/dtread.py（finding 分頁與 X-Total-Count 核對）、
#   tools/e2e/djread.py（DejaCode 授權與 usage policy；無授權標 no_license）、tools/e2e/install-tools.sh（版本固定值）。
set -uo pipefail
[ "${BASH_VERSINFO[0]}" -ge 4 ] || { echo "需要 bash 4 以上" >&2; exit 64; }
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)

usage(){ sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; }
optval(){ [ $# -ge 2 ] || { echo "$1 要給值" >&2; usage >&2; exit 64; }; }   # 要值的選項在最後又沒給值時，不讓 shift 2 失敗而無窮迴圈
MODE= SRC= REF= NAME= OUT= PVER= PVER_SET=0 NOUP=0 NETRES=0 PKGSCAN=1 FILESCAN=1 LICENSE=1 KBUILD= KBUILD_PREFIX= PYVERS= KVERS=() KVERS_CLI=0 KUPS=() KOTHER= KOTHER_CLI=0 KNOTDISTRO= KNOTDISTRO_CLI=0
while [ $# -gt 0 ]; do case $1 in
  --git) optval "$@"; MODE=git; SRC=$2; shift 2;;
  --dir) optval "$@"; MODE=dir; SRC=$2; shift 2;;
  --image) optval "$@"; MODE=image; SRC=$2; shift 2;;
  --sbom) optval "$@"; MODE=sbom; SRC=$2; shift 2;;
  --ref) optval "$@"; REF=$2; shift 2;;
  --name) optval "$@"; NAME=$2; shift 2;;
  --out) optval "$@"; OUT=$2; shift 2;;
  --version) optval "$@"; PVER=$2; PVER_SET=1; shift 2;;
  --no-upload) NOUP=1; shift;;
  --allow-network-resolve) NETRES=1; shift;;
  --no-package-scan) PKGSCAN=0; shift;;
  --no-files-scan) FILESCAN=0; shift;;
  --no-license) LICENSE=0; shift;;
  --kernel-build) optval "$@"; KBUILD=$2; shift 2;;
  --kernel-build-prefix) optval "$@"; KBUILD_PREFIX=$2; shift 2;;
  --py-versions) optval "$@"; PYVERS=$2; shift 2;;
  --kernel-version) optval "$@"; KVERS+=("$2"); KVERS_CLI=1; shift 2;;
  --kernel-upstream-version) optval "$@"; KUPS+=("$2"); shift 2;;
  --kernel-in-other-report) optval "$@"; KOTHER=$2; KOTHER_CLI=1; shift 2;;
  --kernel-not-distro) optval "$@"; KNOTDISTRO=$2; KNOTDISTRO_CLI=1; shift 2;;
  -h|--help) usage; exit 0;;
  *) echo "不認得的參數：$1" >&2; usage >&2; exit 64;;
esac; done
[ -n "$MODE" ] && [ -n "$SRC" ] || { echo "需要 --git、--dir、--image 或 --sbom 其中之一" >&2; usage >&2; exit 64; }
# --version：DT 的 name／version 查詢與 DejaCode 的 name:version 都用它，所以只收安全的字元（不含「:」「/」、引號、控制字元）
if [ $PVER_SET = 1 ] && ! [[ "$PVER" =~ ^[A-Za-z0-9][A-Za-z0-9\ ._+~()-]{0,99}$ ]] ; then
  echo "--version 只接受英數字開頭、英數字與「空白 . _ + ~ ( ) -」，最多 100 字元：${PVER:0:120}" >&2; exit 64; fi
if [ "$MODE" = git ]; then
  [[ "$REF" =~ ^[0-9a-f]{40}$|^[0-9a-f]{64}$ ]] || { echo "--git 需要 --ref <完整 commit SHA>（40 或 64 個小寫十六進位字元；不接受分支或標籤，避免結果隨時間改變）" >&2; exit 64; }
elif [ -n "$REF" ]; then echo "--ref 只用於 --git" >&2; exit 64; fi
if [ -n "$PYVERS" ]; then
  [[ "$MODE" =~ ^(image|sbom)$ ]] || { echo "--py-versions 只用於 --image 或 --sbom" >&2; exit 64; }
  [ -f "$PYVERS" ] || { echo "--py-versions 找不到：$PYVERS" >&2; exit 64; }
  PYVERS=$(readlink -f -- "$PYVERS")
fi
[ "$MODE" = dir ] && { [ -d "$SRC" ] || { echo "不是資料夾：$SRC" >&2; exit 64; }; SRC=$(cd "$SRC" && pwd); }
[ "$MODE" = sbom ] && { [ -f "$SRC" ] || { echo "不是檔案：$SRC" >&2; exit 64; }; SRC=$(cd "$(dirname "$SRC")" && pwd)/$(basename "$SRC"); }
[[ "$MODE" =~ ^(image|sbom)$ ]] && [ "$NETRES" = 1 ] && { echo "--allow-network-resolve 只用於原始碼" >&2; exit 64; }
if [ -n "$KBUILD" ] || [ -n "$KBUILD_PREFIX" ]; then
  [[ "$MODE" =~ ^(image|sbom)$ ]] || { echo "--kernel-build 只用於 --image 或 --sbom" >&2; exit 64; }
  [ -e "$KBUILD" ] || { echo "--kernel-build 找不到：${KBUILD:-未指定}" >&2; exit 64; }
  KBUILD=$(readlink -f -- "$KBUILD")
  [[ -z "$KBUILD_PREFIX" || "$KBUILD_PREFIX" =~ ^[A-Za-z0-9._/-]{1,300}$ ]] && [[ "/$KBUILD_PREFIX/" != */../* ]] \
    || { echo "--kernel-build-prefix 只接受英數字與「. _ / -」，不能有 ..：$KBUILD_PREFIX" >&2; exit 64; }
fi
# --kernel-version／SCA_KERNEL_VERSIONS：核心版本（映像 /usr/lib/modules/ 底下的資料夾名稱）。只收英數字開頭、英數字與「. _ + ~ -」
# （不含 shell 特殊字元、「/」、空白），其餘 exit 64；工具另有自己的檢查。環境變數只在 --image、--sbom 看（其他模式沒有核心可判定）；命令列有給就不看環境變數。
kernel_versions_args(){
  local t kv LC_ALL=C      # 字元範圍 [A-Za-z] 在 UTF-8 地區設定下可能含重音字母
  if [ "$KVERS_CLI" = 1 ]; then
